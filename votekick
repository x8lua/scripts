end

-- Fast Auto-kick function with immediate teleportation (no ground detection)
local function autoKickPlayer(plr)
	local playerKey = plr.Name:lower()

	-- Check ban status with new structure
	local banInfo = votekickBans[playerKey]
	if not banInfo then
		return -- Player is not banned, skip
	end

	-- Double-check ban validity (in case of race conditions)
	if type(banInfo) == 'table' then
		local currentTime = os.time()
		local banAge = currentTime - banInfo.timestamp
		local differentServer = banInfo.jobId ~= currentJobId

		-- Check if ban should be expired
		if
			(differentServer and banAge > 300) or (banAge > BAN_EXPIRATION_TIME)
		then
			print(
				'[votekick] ban expired for '
					.. displayOf(plr)
					.. ', removing ban'
			)
			votekickBans[playerKey] = nil
			_G.__stacyVotekickBans[playerKey] = nil
			saveVotekickBans()
			return
		end
	end

	print(
		'[votekick] detected banned player, starting immediate teleportation: '
			.. displayOf(plr)
	)

	-- Wait for character to load if needed
	if not plr.Character or not plr.Character:FindFirstChild('HumanoidRootPart') then
		plr.CharacterAdded:Wait()
		task.wait(0.5) -- Wait for character to fully load
	end

	-- Start immediate teleportation process - 30 attempts every 0.7 seconds
	local TARGET_X, TARGET_Y, TARGET_Z = -250, 784, 236
	local RADIUS = 50
	local maxAttempts = 30
	local attempts = 0
	local currentCharacter = plr.Character

	-- Function to check if player is in radius
	local function isInRadius()
		if not plr.Character or not plr.Character:FindFirstChild('HumanoidRootPart') then
			return false
		end

		local hrp = plr.Character.HumanoidRootPart
		local distance = (hrp.Position - Vector3.new(TARGET_X, TARGET_Y, TARGET_Z)).Magnitude
		return distance <= RADIUS
	end

	-- Monitor for character resets
	local resetConnection = plr.CharacterAdded:Connect(function(newChar)
		print('[votekick] Character reset detected for ' .. displayOf(plr) .. ' - updating reference')
		currentCharacter = newChar
		task.wait(0.5) -- Brief wait for character to load
	end)

	-- Start teleportation loop
	while attempts < maxAttempts and plr.Parent do
		attempts = attempts + 1
		print('[votekick] Teleportation attempt #' .. attempts .. ' for ' .. displayOf(plr))

		-- Check if character changed (reset detected)
		if plr.Character ~= currentCharacter then
			print('[votekick] Character reset detected! Updating reference...')
			currentCharacter = plr.Character
			task.wait(0.5) -- Wait for character to load
		end

		-- Check if player is in radius
		if isInRadius() then
			print('[votekick] Player now in radius, proceeding with kick')
			break
		end

		-- Teleport to wp-dna
		chat(':tp ' .. plr.Name .. ' wp-dna')

		-- Wait 0.7 seconds before next attempt
		task.wait(0.7)
	end

	-- Clean up reset connection
	if resetConnection then
		resetConnection:Disconnect()
	end

	-- Execute the kick sequence
	if plr.Parent and plr.Character then
		-- Execute the kick
		chat(':unfly ' .. plr.Name)
		task.wait(0.05)

		local kickMessage = ('[Votekick System] %s was VOTEKICKED and cannot rejoin this server.'):format(
			displayOf(plr)
		)

		tpAndTripleTalk(plr, 82130923335295, kickMessage)

		print('[votekick] successfully auto-kicked ' .. displayOf(plr))
	else
		print('[votekick] Player left before kick execution')
	end
end


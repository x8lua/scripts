-- Votekick blacklist system (shared database)
local BLACKLIST_FILE = 'votekick_blacklist.json'
_G.__stacyVotekickBlacklist = _G.__stacyVotekickBlacklist or {}
local votekickBlacklist = _G.__stacyVotekickBlacklist

local function loadVotekickBlacklist()
	local ok, content = pcall(readfile, BLACKLIST_FILE)
	if ok and content then
		local success, data = pcall(function()
			return HttpService:JSONDecode(content)
		end)
		if success and type(data) == 'table' then
			for k, v in pairs(data) do
				votekickBlacklist[k] = v
			end
		end
	end
end

local function saveVotekickBlacklist()
	local json = HttpService:JSONEncode(votekickBlacklist)
	local ok, err = pcall(writefile, BLACKLIST_FILE, json)
	if not ok then
		print('[votekick blacklist] failed to write database: ' .. tostring(err))
	end
end

-- Load blacklist on initialization
if not _G.__stacyVotekickBlacklistLoaded then
	_G.__stacyVotekickBlacklistLoaded = true
	loadVotekickBlacklist()
end


-- build 64-DNA string for StacyCMD compatibility
local GENE64 = ('🧬'):rep(64)

local function displayOf(plr)
    return string.format('%s (@%s)', plr.DisplayName, plr.Name)
end

-- StacyCMD tp + 3x talk + notify (music + chat)
local function tpAndTripleTalk(plr, musicId, notifyText)
    chat((':exacttp %s wp-dna'):format(plr.Name))
    task.wait(0.6)
    chat((':talk %s %s'):format(plr.Name, GENE64))
    task.wait(0.25)
    chat((':talk %s %s'):format(plr.Name, GENE64))
    task.wait(0.25)
    chat((':talk %s %s'):format(plr.Name, GENE64))
    if musicId and notifyText then
        chat(
            (':localmusic all %s true 1 inf|:chatnotifyc all 252,186,3  %s'):format(
                tostring(musicId),
                notifyText
            )
        )
    end
end


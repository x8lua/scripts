-- FIXED: Ban persistence system with server tracking
local BAN_FILE = 'votekick_bans.json'

local function loadVotekickBans()
	local ok, content = pcall(readfile, BAN_FILE)
	if ok and content then
		local success, data = pcall(function()
			return HttpService:JSONDecode(content)
		end)
		if success and type(data) == 'table' then
			local validBans = {}
			local currentTime = os.time()

			for playerName, banInfo in pairs(data) do
				-- Check if ban data has proper structure
				if
					type(banInfo) == 'table'
					and banInfo.jobId
					and banInfo.timestamp
				then
					-- Check if ban should expire
					local banAge = currentTime - banInfo.timestamp
					local differentServer = banInfo.jobId ~= currentJobId

					-- Ban expires if:
					-- 1. It's from a different server AND more than 5 minutes old
					-- 2. It's older than 30 minutes regardless of server
					if
						(differentServer and banAge > 300)
						or (banAge > BAN_EXPIRATION_TIME)
					then
						print(
							'[votekick] expired ban for '
								.. playerName
								.. ' (age: '
								.. banAge
								.. 's, different server: '
								.. tostring(differentServer)
								.. ')'
						)
					else
						validBans[playerName] = banInfo
						_G.__stacyVotekickBans[playerName] = banInfo -- Sync with global
					end
				elseif banInfo == true then
					-- Old format, convert to new structure or expire if too old
					print(
						'[votekick] converting old ban format for '
							.. playerName
					)
					-- Since we don't know when the old ban was created, expire it
				end
			end

			-- Update both local and global with valid bans
			for k, v in pairs(votekickBans) do
				if not validBans[k] then
					votekickBans[k] = nil
					_G.__stacyVotekickBans[k] = nil
				end
			end

			for k, v in pairs(validBans) do
				votekickBans[k] = v
				_G.__stacyVotekickBans[k] = v
			end

			print('[votekick] loaded ' .. #validBans .. ' valid bans from file')
		end
	end
end

local function saveVotekickBans()
	local json = HttpService:JSONEncode(votekickBans)
	local ok, err = pcall(writefile, BAN_FILE, json)
	if not ok then
		print('[votekick bans] failed to write database: ' .. tostring(err))
	else
		print('[votekick] saved ban database')
	end
end

local function loadVotekickBlacklist()
	local ok, content = pcall(readfile, BLACKLIST_FILE)
	if ok and content then
		local success, data = pcall(function()
			return HttpService:JSONDecode(content)
		end)
		if success and type(data) == 'table' then
			for k, v in pairs(data) do
				votekickBlacklist[k] = v
			end
		end
	end
end

local function saveVotekickBlacklist()
	local json = HttpService:JSONEncode(votekickBlacklist)
	local ok, err = pcall(writefile, BLACKLIST_FILE, json)
	if not ok then
		print(
			'[votekick blacklist] failed to write database: ' .. tostring(err)
		)
	end
end


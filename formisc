local function pizzaRigGetAllRigs()
	local rigs = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		local ingame = map:FindFirstChild("Ingame")
		if ingame then
			for _, child in ipairs(ingame:GetChildren()) do
				-- Check for PizzaDeliveryRig or names containing "Mafia" (case-insensitive)
				if child.Name == "PizzaDeliveryRig" or string.find(string.lower(child.Name), "mafia") then
					table.insert(rigs, child)
				end
			end
		end
	end
	return rigs
end

local function pizzaRigGetDistance(rig)
	if not rig then
		return math.huge
	end
	
	-- Try to find HumanoidRootPart or PrimaryPart (works for both rig and mafia)
	local rigRoot = rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChild("PrimaryPart")
	if not rigRoot and rig:IsA("Model") then
		rigRoot = rig.PrimaryPart
	end
	
	if not pizzaRigHumanoidRootPart or not rigRoot then
		return math.huge
	end
	
	return (pizzaRigHumanoidRootPart.Position - rigRoot.Position).Magnitude
end

local function pizzaRigFindNearestRig()
	local rigs = pizzaRigGetAllRigs()
	if #rigs == 0 then
		return nil, math.huge
	end
	
	local nearestRig = nil
	local nearestDistance = math.huge
	
	for _, rig in ipairs(rigs) do
		local distance = pizzaRigGetDistance(rig)
		if distance < nearestDistance then
			nearestDistance = distance
			nearestRig = rig
		end
	end
	
	return nearestRig, nearestDistance
end

local function pizzaRigGetDistanceColor(distance)
	if distance == math.huge then
		return Color3.fromRGB(200, 200, 200), ""
	end
	
	-- Closer = more dangerous (red)
	if distance < 20 then
		return Color3.fromRGB(255, 0, 0), string.format("EXTREME DANGER! %.1fm", distance) -- Red
	elseif distance < 50 then
		return Color3.fromRGB(255, 50, 0), string.format("VERY DANGEROUS! %.1fm", distance) -- Orange-red
	elseif distance < 100 then
		return Color3.fromRGB(255, 150, 0), string.format("DANGER! %.1fm", distance) -- Orange
	else
		return Color3.fromRGB(255, 200, 0), string.format("WARNING %.1fm", distance) -- Yellow
	end
end

local function pizzaRigFadeText(transparency, duration)
	if not pizzaRigDistanceLabel then return end
	if pizzaRigCurrentTween then
		pizzaRigCurrentTween:Cancel()
	end
	
	local tweenInfo = TweenInfo.new(
		duration or 0.5,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)
	
	pizzaRigCurrentTween = TweenService:Create(pizzaRigDistanceLabel, tweenInfo, {
		TextTransparency = transparency
	})
	
	pizzaRigCurrentTween:Play()
end

local function pizzaRigChangeColor(newColor, duration)
	if not pizzaRigDistanceLabel then return end
	if pizzaRigCurrentColorTween then
		pizzaRigCurrentColorTween:Cancel()
	end
	
	local tweenInfo = TweenInfo.new(
		duration or 0.5,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)
	
	pizzaRigCurrentColorTween = TweenService:Create(pizzaRigDistanceLabel, tweenInfo, {
		TextColor3 = newColor
	})
	
	pizzaRigCurrentColorTween:Play()
end

local function pizzaRigUpdateDisplay()
	if not pizzaRigEnabled then return end
	
	local nearestRig, distance = pizzaRigFindNearestRig()
	local rigs = pizzaRigGetAllRigs()
	
	-- If no rig or distance over 100m, fade out
	if #rigs == 0 or distance > 100 then
		if pizzaRigDistanceLabel and pizzaRigDistanceLabel.TextTransparency < 1 then
			pizzaRigFadeText(1, 0.5) -- Fade out
		end
		return
	end
	
	-- Within 100m, fade in and display
	local color, text = pizzaRigGetDistanceColor(distance)
	
	-- Update text
	if pizzaRigDistanceLabel then
		pizzaRigDistanceLabel.Text = text
		
		-- Smoothly change color (TweenService handles color interpolation)
		pizzaRigChangeColor(color, 0.5)
		
		-- If currently transparent, fade in
		if pizzaRigDistanceLabel.TextTransparency >= 0.9 then
			pizzaRigFadeText(0, 0.5) -- Fade in
		end
	end
end


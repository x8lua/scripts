local function getKillersFolder()
    local p = workspace:FindFirstChild("Players")
    if p then return p:FindFirstChild("Killers") or p:FindFirstChild("Killer") end
    return workspace:FindFirstChild("Killers")
end

local function nearestKillerDistance(pos)
    local f = getKillersFolder()
    if not f then return math.huge end
    local nearest = math.huge
    for _, name in ipairs(KILLER_NAMES) do
        local m = f:FindFirstChild(name)
        if m then
            local hrp = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso")
            if hrp then
                local d = (pos - hrp.Position).Magnitude
                if d < nearest then nearest = d end
            end
        end
    end
    return nearest
end

local function destroyAimStick()
    if aimConn then aimConn:Disconnect() aimConn = nil end
    if aimStick then pcall(function() aimStick:Destroy() end); aimStick = nil end
end

local function createAimStick()

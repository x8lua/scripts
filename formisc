									if not rerollEffectActive then
										return
									end
									
									local currentCharges = tonumber(chargesLabel.Text) or 0
									local currentTime = tick()
									
									-- Check if charges decreased to 0 and health changed within 0.3 seconds
									if currentCharges == 0 and lastRerollCharges and lastRerollCharges > 0 then
										local timeSinceHealthChange = currentTime - lastHealthChangeTime
										
										-- Check if player is dead - do not trigger reroll on death
										if humanoid.Health <= 0 then

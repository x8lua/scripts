	Default = '',
	Placeholder = 'Enter a name for this sound (e.g., AK-47, Pistol)',
	Numeric = false,
	Finished = false,
	Callback = function(Value)
		gunshotSaveName = Value or ''
	end,
})

-- Sound ID Input
local GunshotSaveSoundIdInput =
	Tabs.Settings:CreateInput('GunshotSaveSoundId', {
		Title = 'Sound ID',
		Default = '',
		Placeholder = 'Enter Roblox sound ID (e.g., 131961136)',
		Numeric = true,
		Finished = false,
		Callback = function(Value)
			gunshotSaveSoundId = Value or ''
		end,
	})

-- Save Button
local GunshotSaveButton = Tabs.Settings:CreateButton({
	Title = '💾 Save Gunshot Sound',
	Description = 'Save the sound with the specified name and ID',
	Callback = function()
		local success, message =
			addGunshotSound(gunshotSaveName, gunshotSaveSoundId)

		if success then
			Library:Notify({
				Title = '✅ Success',
				Content = message,
				Duration = 3,
			})

			-- Clear inputs after successful save
			gunshotSaveName = ''
			gunshotSaveSoundId = ''
			GunshotSaveNameInput:SetValue('')
			GunshotSaveSoundIdInput:SetValue('')
		else
			Library:Notify({
				Title = '❌ Error',
				Content = message,
				Duration = 5,
			})
		end
	end,
})


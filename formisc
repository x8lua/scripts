-- Function to check if target player is playing a specific animation
local function isPlayingAnimation(targetPlayer, animationId)
    if not targetPlayer or not animationId then
        return false
    end
    
    -- Normalize target animation ID
    local targetNumericId = normalizeAssetId(tostring(animationId))
    if not targetNumericId then
        return false
    end
    
    -- Handle both Player objects and Character models
    local character = targetPlayer
    if targetPlayer.Character then
        character = targetPlayer.Character
    end
    
    if not character then
        return false
    end
    
    -- First, check tracked state (event-based, more reliable)
    if animationTrackingState[character] then
        local isPlaying = animationTrackingState[character][targetNumericId]
        if isPlaying == true then
            return true
        end
    end
    
    -- Fallback to polling if state not available yet
    local success, result = pcall(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            return false
        end
        
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            return false
        end
        
        -- Get all currently playing animation tracks
        local tracks = animator:GetPlayingAnimationTracks()
        
        -- Check each playing track
        for _, track in ipairs(tracks) do
            if track and track.Animation and track.IsPlaying then
                local animIdString = tostring(track.Animation.AnimationId)
                
                -- Use both string matching (more flexible) and numeric comparison (more precise)
                -- String matching handles different formats like "rbxassetid://121086746534252" or just "121086746534252"
                if animIdString:find(targetNumericId, 1, true) then
                    return true
                end
                
                -- Also try normalized numeric comparison for exact match
                local currentNumericId = normalizeAssetId(animIdString)
                if currentNumericId and currentNumericId == targetNumericId then
                    return true
                end
            end
        end
        
        return false
    end)
    
    if not success then
        return false
    end
    return result
end

-- Function to get hitbox size for a player
local function getHitboxSize(playerName, targetPlayer)
    -- Check both playerName (from sound detection) and character model name
    local isSlasher = (playerName == "Slasher") or (targetPlayer and targetPlayer.Name == "Slasher")
    
    if isSlasher and targetPlayer then
        -- GW hitbox: Slasher animation 121086746534252
        if isPlayingAnimation(targetPlayer, "121086746534252") then
            return Vector3.new(8, 4, 8) * hitboxSizeMultiplier
        end
        -- Behead hitbox: Slasher animation 126355327951215
        if isPlayingAnimation(targetPlayer, "126355327951215") then
            return Vector3.new(8, 2, 7) * hitboxSizeMultiplier
        end
		-- Additional Slasher case: animation 106847695270773
		if isPlayingAnimation(targetPlayer, "106847695270773") then
			return Vector3.new(8, 4, 8) * hitboxSizeMultiplier
		end
    end
    
    local baseSize = HITBOX_SIZES[playerName] or HITBOX_SIZES.default
    return baseSize * hitboxSizeMultiplier
end

-- Function to get hitbox offset for a player
local function getHitboxOffset(playerName)
    return HITBOX_OFFSETS[playerName] or HITBOX_OFFSETS.default
end

-- Function to create a new hitbox at current position
local function createHitbox(targetPlayer, playerName)
    if not targetPlayer then return end
    
    -- Ensure animation tracking is set up for this character
    if targetPlayer:FindFirstChildOfClass("Humanoid") then
        setupCharacter(targetPlayer)
    end
    
    local humanoidRootPart = targetPlayer:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local killerCFrame = humanoidRootPart.CFrame
    local lookVector = killerCFrame.LookVector
    
    local hitboxOffset = getHitboxOffset(playerName)
    local hitboxPosition = killerCFrame.Position + (lookVector * hitboxOffset)
    
    -- Rotation: Face in the same direction the killer is facing
    local hitboxCFrame = CFrame.new(hitboxPosition, hitboxPosition + lookVector)
    
    local hitboxSize
    local success, result = pcall(function()
        return getHitboxSize(playerName, targetPlayer)
    end)
    if success then
        hitboxSize = result
    else
        -- Fallback to default size if there's any error
        local baseSize = HITBOX_SIZES[playerName] or HITBOX_SIZES.default
        hitboxSize = baseSize * hitboxSizeMultiplier
    end
    
    local hitbox = Instance.new("Part")
    hitbox.Name = "KillerHitbox"
    hitbox.Size = hitboxSize
    hitbox.Color = Color3.fromRGB(128, 0, 128) -- Purple
    hitbox.Transparency = HITBOX_TRANSPARENCY
    hitbox.Material = Enum.Material.ForceField
    hitbox.CanCollide = false
    hitbox.Anchored = true
    hitbox.CFrame = hitboxCFrame
    hitbox.Parent = workspace
    
    local touched = false
    local hitboxData = {
        part = hitbox,
        creationTime = tick(),
        connection = nil,
        frameCheckConnection = nil,
        frameCheckCount = 0,
        wasInsideFirst2Frames = false
    }
    
    -- Frame tracking for HitBox Drag
    if hitboxDragEnabled then
        hitboxData.frameCheckConnection = RunService.Heartbeat:Connect(function()
            if not hitbox or not hitbox.Parent then
                if hitboxData.frameCheckConnection then 
                    hitboxData.frameCheckConnection:Disconnect()
                    hitboxData.frameCheckConnection = nil
                end
                return
            end
            
            hitboxData.frameCheckCount = hitboxData.frameCheckCount + 1
            
            if hitboxData.frameCheckCount <= 2 then
                if isPlayerInsideHitbox(hitbox) then
                    hitboxData.wasInsideFirst2Frames = true
                end
            else
                -- Stop checking after 2 frames
                if hitboxData.frameCheckConnection then 
                    hitboxData.frameCheckConnection:Disconnect()
                    hitboxData.frameCheckConnection = nil
                end
            end
        end)
    end
    
    local touchConnection = hitbox.Touched:Connect(function(hit)
        if touched then return end -- Prevent multiple fires
        
        -- Check cooldown before triggering
        if isCooldownActive() then return end
        
        local character = hit.Parent
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if player and player.Character == character and humanoid and character:FindFirstChild("HumanoidRootPart") then
            touched = true
            fireGuiBlock(hitboxData)
        end
    end)
    
    hitboxData.connection = touchConnection
    table.insert(activeHitboxes, hitboxData)
    
    task.delay(HITBOX_LIFETIME, function()
        if touchConnection then
            touchConnection:Disconnect()
        end
        if hitboxData.frameCheckConnection then
            hitboxData.frameCheckConnection:Disconnect()
        end
        if hitbox and hitbox.Parent then
            hitbox:Destroy()
        end
        for i, data in ipairs(activeHitboxes) do
            if data.part == hitbox then
                table.remove(activeHitboxes, i)
                break
            end
        end
    end)
end

local function destroyAllHitboxes()
    for _, hitboxData in ipairs(activeHitboxes) do
        if hitboxData.connection then
            hitboxData.connection:Disconnect()
        end
        if hitboxData.frameCheckConnection then
            hitboxData.frameCheckConnection:Disconnect()
        end
        if hitboxData.part and hitboxData.part.Parent then
            hitboxData.part:Destroy()
        end
    end
    table.clear(activeHitboxes)
end


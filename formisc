			local survivorRoot = survivor:FindFirstChild("HumanoidRootPart")
			if survivorRoot then
				local distance = (hrp.Position - survivorRoot.Position).Magnitude
				if distance < minDist then
					minDist = distance
					nearest = survivor
				end
			end
		end
	end
	return nearest, minDist
end

local function pmusGetPhaseForDistance(distance)
	for i, phase in ipairs(pmusPhases) do
		if distance > phase.minDist and distance <= phase.maxDist then
			return i, phase
		end
	end
	if distance <= 13 then
		return 4, pmusPhases[4]
	end
	return nil, nil
end

local function pmusCleanupMusic()
	if pmusSound and pmusSound.Parent then
		if pmusSound.Playing then pmusSound:Stop() end
		pmusSound.Volume = 0
		pmusSound:Destroy()
	end
	pmusSound = nil
	if pmusMapAmbience and pmusMapAmbience:IsA("Sound") then
		pmusMapAmbience.Volume = pmusOriginalAmbienceVolume
	end
	if pmusPhase4Sound and pmusPhase4Sound:IsA("Sound") and not pmusPhase4Sound.Playing then
		pmusPhase4Sound:Resume()
		print("Phase 4 sound resumed (cleanup): rbxassetid://128246743331929")
	end
	pmusCurrentPhase = nil
	pmusInPhase4Lockout = false
	pmusNearestSurvivor = nil
	pmusNearestDistance = math.huge
end

local function pmusUpdateMusic(phaseIndex, phase)
	if not pmusEnabled then return end
	if pmusInPhase4Lockout then
		if pmusNearestDistance >= PMUS_REACTIVATION_DISTANCE then
			pmusInPhase4Lockout = false
			pmusCurrentPhase = nil
			if pmusSound and pmusSound.Playing then
				task.spawn(function()
					pmusFadeOut(pmusSound, PMUS_FADE_DURATION)
					pmusFadeInAmbience()
				end)
			end
			if pmusPhase4Sound and pmusPhase4Sound:IsA("Sound") and not pmusPhase4Sound.Playing then
				pmusPhase4Sound:Resume()
				print("Phase 4 sound resumed: rbxassetid://128246743331929")
			end
		else
			if phaseIndex == 4 then
				if pmusSound and (not pmusSound.Playing) and phase.soundId then
					task.spawn(function()
						pmusFadeOutAmbience()
						pmusSound.SoundId = phase.soundId
						pmusFadeIn(pmusSound, PMUS_TARGET_VOLUME, PMUS_FADE_DURATION)
						print("Resumed Phase 4 music")
					end)
				end
			end
			return
		end
	end
	if phaseIndex == 4 then
		if pmusPhase4Sound and pmusPhase4Sound:IsA("Sound") and pmusPhase4Sound.Playing then
			pmusPhase4Sound:Pause()
			print("Phase 4: Paused workspace.Themes Phase 4 sound")
		end
		if pmusCurrentPhase ~= phaseIndex and phase.soundId then
			pmusCurrentPhase = phaseIndex
			task.spawn(function()
				if pmusSound and pmusSound.Playing then pmusFadeOut(pmusSound, PMUS_FADE_DURATION) end
				pmusFadeOutAmbience()
				pmusCreateSound()
				pmusSound.SoundId = phase.soundId
				pmusFadeIn(pmusSound, PMUS_TARGET_VOLUME, PMUS_FADE_DURATION)
				print("Switched to " .. phase.name .. " (playing our own Phase 4 music)")
			end)
		elseif pmusSound and (not pmusSound.Playing) and phase.soundId then
			task.spawn(function()
				pmusFadeOutAmbience()
				pmusCreateSound()
				pmusSound.SoundId = phase.soundId
				pmusFadeIn(pmusSound, PMUS_TARGET_VOLUME, PMUS_FADE_DURATION)
				print("Started " .. phase.name .. " (playing our own Phase 4 music)")
			end)
		end
		pmusInPhase4Lockout = true
		return
	end
	if pmusCurrentPhase ~= phaseIndex and phase.soundId then
		pmusCurrentPhase = phaseIndex
		task.spawn(function()
			if pmusSound and pmusSound.Playing then pmusFadeOut(pmusSound, PMUS_FADE_DURATION) end
			pmusFadeOutAmbience()
			pmusCreateSound()
			pmusSound.SoundId = phase.soundId
			pmusFadeIn(pmusSound, PMUS_TARGET_VOLUME, PMUS_FADE_DURATION)
			print("Switched to " .. phase.name)
		end)
	elseif pmusSound and (not pmusSound.Playing) and phase.soundId and not pmusInPhase4Lockout then
		task.spawn(function()
			pmusFadeOutAmbience()
			pmusCreateSound()
			pmusSound.SoundId = phase.soundId
			pmusFadeIn(pmusSound, PMUS_TARGET_VOLUME, PMUS_FADE_DURATION)
		end)
		pmusCurrentPhase = phaseIndex
	end
end

local function pmusPausePhase4IfNeeded(sound)
	if sound and sound:IsA("Sound") and sound.SoundId == "rbxassetid://128246743331929" then
		if pmusInPhase4Lockout and sound.Playing then
			sound:Pause()
			print("Phase 4: Auto-paused rbxassetid://128246743331929 (detected in workspace.Themes)")
		end
	end
end

local function pmusPauseForLastSurvivor()
	if pmusPausedForLMS then return end
	pmusPausedForLMS = true
	if pmusSound and pmusSound.Playing then
		task.spawn(function()
			pmusFadeOut(pmusSound, PMUS_FADE_DURATION)
			pmusFadeInAmbience()
		end)
	end
	pmusInPhase4Lockout = false
	pmusCurrentPhase = nil
	print("Proximity Music System: Paused (LastSurvivor active)")
end

local function pmusResumeAfterLastSurvivor()
	if not pmusPausedForLMS then return end
	pmusPausedForLMS = false
	pmusLastUpdate = 0
	print("Proximity Music System: Resumed (LastSurvivor gone)")
end

local function pmusAttachThemeWatcher()
	local themesFolder = workspace:FindFirstChild("Themes")
	if not themesFolder then return end
	local existing = themesFolder:FindFirstChild("rbxassetid://128246743331929")
	if existing and existing:IsA("Sound") then
		pmusPhase4Sound = existing
		pmusPausePhase4IfNeeded(pmusPhase4Sound)
	end
	local existingLMS = themesFolder:FindFirstChild("LastSurvivor")
	if existingLMS and existingLMS:IsA("Sound") then
		pmusLastSurvivorSound = existingLMS
		pmusPauseForLastSurvivor()
	end
	pmusThemesConn = themesFolder.ChildAdded:Connect(function(child)
		if child.Name == "rbxassetid://128246743331929" and child:IsA("Sound") then
			pmusPhase4Sound = child
			pmusPausePhase4IfNeeded(child)
		elseif child.Name == "LastSurvivor" and child:IsA("Sound") then
			pmusLastSurvivorSound = child
			pmusPauseForLastSurvivor()
		end
	end)
	pmusThemesConnRemoved = themesFolder.ChildRemoved:Connect(function(child)
		if child == pmusLastSurvivorSound or child.Name == "LastSurvivor" then
			pmusLastSurvivorSound = nil
			pmusResumeAfterLastSurvivor()
		end
	end)
end

local function pmusDetachThemeWatcher()
	if pmusThemesConn then pmusThemesConn:Disconnect() pmusThemesConn = nil end
	if pmusThemesConnRemoved then pmusThemesConnRemoved:Disconnect() pmusThemesConnRemoved = nil end
end

local function pmusStart()
	if pmusEnabled then return end
	pmusEnabled = true
	pmusCreateSound()
	pmusMapAmbience = workspace:FindFirstChild("Themes") and workspace.Themes:FindFirstChild("MapAmbience")
	pmusOriginalAmbienceVolume = pmusMapAmbience and pmusMapAmbience.Volume or 0
	pmusPhase4Sound = workspace:FindFirstChild("Themes") and workspace.Themes:FindFirstChild("rbxassetid://128246743331929")
	if pmusPhase4Sound then pmusPausePhase4IfNeeded(pmusPhase4Sound) end
	pmusAttachThemeWatcher()
	pmusLastUpdate = 0
	pmusWasKiller = pmusCheckIfKiller()
	pmusIsKiller = pmusWasKiller
	pmusUpdateNearestLabel()
	if pmusConn then pmusConn:Disconnect() end
	pmusConn = RunService.Heartbeat:Connect(function()
		local now = tick()
		if now - pmusLastUpdate < PMUS_UPDATE_INTERVAL then return end
		pmusLastUpdate = now
		if pmusPausedForLMS then
			pmusUpdateNearestLabel()
			return
		end
		pmusIsKiller = pmusCheckIfKiller()
		if pmusWasKiller and not pmusIsKiller then
			pmusCleanupMusic()
			print("Proximity Music System: WAITING (No longer killer)")
		elseif (not pmusWasKiller) and pmusIsKiller then
			print("Proximity Music System: ACTIVE (Killer detected!)")
		end
		pmusWasKiller = pmusIsKiller
		if not pmusIsKiller then pmusUpdateNearestLabel() return end
		pmusNearestSurvivor, pmusNearestDistance = pmusGetNearestSurvivor()
		if pmusNearestSurvivor then
			pmusUpdateNearestLabel()
			local phaseIndex, phase = pmusGetPhaseForDistance(pmusNearestDistance)
			if phaseIndex then
				pmusUpdateMusic(phaseIndex, phase)
			else
				if pmusSound and pmusSound.Playing then
					task.spawn(function()
						pmusFadeOut(pmusSound, PMUS_FADE_DURATION)
						pmusFadeInAmbience()
					end)
				end
				if pmusInPhase4Lockout and pmusPhase4Sound and pmusPhase4Sound:IsA("Sound") and not pmusPhase4Sound.Playing then
					pmusPhase4Sound:Resume()
					print("Phase 4 sound resumed (out of range): rbxassetid://128246743331929")
				end
				pmusInPhase4Lockout = false
				pmusCurrentPhase = nil
			end
		else
			if pmusSound and pmusSound.Playing then
				task.spawn(function()
					pmusFadeOut(pmusSound, PMUS_FADE_DURATION)
					pmusFadeInAmbience()
				end)
			end
			if pmusInPhase4Lockout and pmusPhase4Sound and pmusPhase4Sound:IsA("Sound") and not pmusPhase4Sound.Playing then
				pmusPhase4Sound:Resume()
				print("Phase 4 sound resumed (no survivors): rbxassetid://128246743331929")
			end
			pmusInPhase4Lockout = false
			pmusCurrentPhase = nil
			pmusUpdateNearestLabel()
		end
	end)
	Library:Notify({ Title = "Proximity Music", Description = "Apollyon music system loaded!", Time = 3 })
end

local function pmusStop()
	pmusEnabled = false
	if pmusConn then pmusConn:Disconnect() pmusConn = nil end
	pmusDetachThemeWatcher()
	pmusCleanupMusic()
	pmusUpdateNearestLabel()
	Library:Notify({ Title = "Proximity Music", Description = "Disabled", Time = 2 })
end


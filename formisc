		customMusicLog("ERROR: isfile function not available")
		return nil
	end
	if not isfile(path) then
		customMusicLog("File not found: " .. path)
		return nil
	end
	if not getcustomasset then
		customMusicLog("ERROR: getcustomasset function not available in your executor")
		return nil
	end
	-- Call getcustomasset directly with the path
	local success, asset = pcall(function()
		return getcustomasset(path)
	end)
	if success and asset and asset ~= "" then
		customMusicLog("Loaded: " .. path)
		return asset
	else
		customMusicLog("Failed to load: " .. path .. " (error: " .. tostring(asset) .. ")")
		return nil
	end
end


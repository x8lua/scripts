-- mp3 file management
local lmsFiles = {}
local lobbyFiles = {}
local supportedAudioFormats = { '.mp3', '.ogg', '.wav' }

-- function to scan for LMS mp3 files
local function scanLMSFiles()
	lmsFiles = {}
	if isfolder(lmsFolderName) then
		local files = listfiles(lmsFolderName)
		for _, filePath in ipairs(files) do
			local fileName = filePath:match('([^/\\]+)$')
			for _, format in ipairs(supportedAudioFormats) do
				if fileName:lower():match(format .. '$') then
					table.insert(lmsFiles, filePath)
					break
				end
			end
		end
	end
end

-- function to scan for Lobby mp3 files
local function scanLobbyFiles()
	lobbyFiles = {}
	if isfolder(lobbyFolderName) then
		local files = listfiles(lobbyFolderName)
		for _, filePath in ipairs(files) do
			local fileName = filePath:match('([^/\\]+)$')
			for _, format in ipairs(supportedAudioFormats) do
				if fileName:lower():match(format .. '$') then
					table.insert(lobbyFiles, filePath)
					break
				end
			end
		end
	end
end


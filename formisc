-- Get the currently active sound config
local function getActiveSoundConfig()
	if tetrioSoundActive then
		return TETRIO_SOUND_CONFIG
	elseif wtfSoundActive then
		return WTF_SOUND_CONFIG
	end
	return {}
end

-- Play sound for animation
local function playAnimationSound(animId)
	local activeSoundConfig = getActiveSoundConfig()
	local soundConfig = activeSoundConfig[animId]
	if not soundConfig then
		return
	end

	local success, result = pcall(function()
		local sound = Instance.new('Sound')

		-- Set sound source based on type
		if soundConfig.type == 'file' then
			sound.SoundId = getcustomasset(soundConfig.path)
		elseif soundConfig.type == 'soundid' then
			sound.SoundId = soundConfig.soundId
		end

		sound.Volume = customGunshotVolume or 2
		sound.TimePosition = soundConfig.timePosition or 0
		sound.Parent = game.Workspace
		sound:Play()

		-- Clean up after playing
		sound.Ended:Connect(function()
			sound:Destroy()
		end)

		print('🔊 Playing sound: ' .. soundConfig.name)
	end)

	if not success then
		warn(
			'❌ Failed to play sound for '
				.. animId
				.. ': '
				.. tostring(result)
		)
	end
end

-- Detect animations and play sounds on start
local function detectAnimations()
	local player = game.Players.LocalPlayer
	if not player or not player.Character then
		return
	end

	local humanoid = player.Character:FindFirstChild('Humanoid')
	if not humanoid then
		return
	end

	local tracks = humanoid:GetPlayingAnimationTracks()
	local currentlyPlaying = {}
	local activeSoundConfig = getActiveSoundConfig()

	for _, track in pairs(tracks) do
		if track.IsPlaying then
			local animId = track.Animation.AnimationId
			currentlyPlaying[animId] = true

			-- NEW animation detected - play sound if configured
			if activeSoundConfig[animId] and not playingAnimations[animId] then
				playAnimationSound(animId)
			end
		end
	end

	playingAnimations = currentlyPlaying
end

-- Start animation sound monitoring (respawn-safe)
local function startAnimationSounds()
	if animSoundConnection then
		animSoundConnection:Disconnect()
	end

	playingAnimations = {}

	-- Monitor animations every 0.5 seconds
	local RunService = game:GetService('RunService')
	animSoundConnection = RunService.Heartbeat:Connect(function()
		detectAnimations()
		task.wait(0.5)
	end)

	-- Respawn safety
	local player = game.Players.LocalPlayer
	if player then
		player.CharacterAdded:Connect(function()
			if wtfSoundActive or tetrioSoundActive then
				task.wait(1)
				playingAnimations = {}
				detectAnimations()
			end
		end)
	end

	detectAnimations()
	
	-- Count active sounds
	local activeSoundConfig = getActiveSoundConfig()
	local soundCount = 0
	for _ in pairs(activeSoundConfig) do
		soundCount = soundCount + 1
	end
	
	local systemName = tetrioSoundActive and 'TETRIO' or 'WTF'
	print('🎵 ' .. systemName .. ' Sound System: ENABLED (respawn-safe)')
	print('   Monitoring ' .. soundCount .. ' animation(s)')
end

-- Stop animation sound monitoring
local function stopAnimationSounds()
	if animSoundConnection then
		animSoundConnection:Disconnect()
		animSoundConnection = nil
	end
	playingAnimations = {}
	print('🎵 Animation Sound System: DISABLED')
end


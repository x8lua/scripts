local function pmusFadeOut(soundObj, duration)
	if not soundObj or not soundObj.Playing then return end
	local startVolume = soundObj.Volume
	local elapsed = 0
	while elapsed < duration and soundObj.Playing do
		elapsed = elapsed + task.wait()
		local alpha = math.min(elapsed / duration, 1)
		soundObj.Volume = startVolume * (1 - alpha)
	end
	soundObj.Volume = 0
	if soundObj.Playing then soundObj:Stop() end
end

local function pmusFadeIn(soundObj, targetVolume, duration)
	if not soundObj then return end
	soundObj.Volume = 0
	if not soundObj.Playing then soundObj:Play() end
	local elapsed = 0
	while elapsed < duration and soundObj.Playing do
		elapsed = elapsed + task.wait()
		local alpha = math.min(elapsed / duration, 1)
		soundObj.Volume = targetVolume * alpha
	end
	soundObj.Volume = targetVolume
end


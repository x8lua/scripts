})

-- ShakeCamera State
local shakeCameraActive = false
local shakeCameraConnection = nil
local maxShakeIntensity = 0.5
local shakeStartDistance = 50
local currentShakeIntensity = 0

-- Helper function to find closest killer
local function findClosestKiller()
	local character = player.Character
	if not character then
		return nil, 0
	end

	local humanoidRootPart = character:FindFirstChild('HumanoidRootPart')
	if not humanoidRootPart then
		return nil, 0
	end

	local playerPos = humanoidRootPart.Position

	local killersFolder = workspace:FindFirstChild('Players')
	if killersFolder then
		killersFolder = killersFolder:FindFirstChild('Killers')
	end

	if not killersFolder then
		return nil, 0
	end

	local closestDist = math.huge
	local closestKiller = nil

	for _, killerModel in ipairs(killersFolder:GetChildren()) do
		if killerModel:IsA('Model') then
					local killerRoot = killerModel:FindFirstChild(
						'HumanoidRootPart'
					) or killerModel:FindFirstChild('Torso')
			if killerRoot then
				local distance = (playerPos - killerRoot.Position).Magnitude
				if distance < closestDist then
					closestDist = distance
					closestKiller = killerModel
				end
			end
		end
	end

	return closestKiller, closestDist == math.huge and 0 or closestDist
end

-- Main shake camera function
local function applyCameraShake()
	if not shakeCameraActive then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local _, distance = findClosestKiller()

	if distance > 0 and distance <= shakeStartDistance then
		-- Calculate shake intensity based on distance
		-- Closer = stronger shake (inverted ratio)
		local ratio = 1 - (distance / shakeStartDistance) -- 0 at max distance, 1 at 0 distance
		currentShakeIntensity = maxShakeIntensity * ratio

		-- Apply random shake to camera
		local offsetX = (math.random() - 0.5) * currentShakeIntensity * 2
		local offsetY = (math.random() - 0.5) * currentShakeIntensity * 2
		local offsetZ = (math.random() - 0.5) * currentShakeIntensity * 0.5

				camera.CFrame = camera.CFrame
					* CFrame.new(offsetX, offsetY, offsetZ)
	else
		currentShakeIntensity = 0
	end
end

-- Start shake camera
local function startShakeCamera()
	if shakeCameraConnection then
		shakeCameraConnection:Disconnect()
		shakeCameraConnection = nil
	end

	shakeCameraConnection = RunService.RenderStepped:Connect(function()
		if shakeCameraActive then
			pcall(applyCameraShake)
		end
	end)

	Library:Notify({
		Title = '✅ Shake Camera Enabled',
		Content = string.format(
			'Camera will shake when killers are within %.0f studs',
			shakeStartDistance
		),
		Duration = 3,
	})
end

-- Stop shake camera
local function stopShakeCamera()
	if shakeCameraConnection then
		shakeCameraConnection:Disconnect()
		shakeCameraConnection = nil
	end

	currentShakeIntensity = 0

	Library:Notify({
		Title = '🔄 Shake Camera Disabled',
		Content = 'Camera shake has been stopped',
		Duration = 3,
	})
end


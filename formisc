local function startStaminaWarn()
    destroyStaminaWarn()

    local ok, staminaLabel = pcall(function()
        return player:WaitForChild("PlayerGui", 5):WaitForChild("TemporaryUI", 5):WaitForChild("PlayerInfo", 5):WaitForChild("Bars", 5):WaitForChild("Stamina", 5):WaitForChild("Amount", 5)
    end)

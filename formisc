local function startSprayWarn()
	if sprayWarnEnabled then return end
	sprayWarnEnabled = true
	
	-- Initial check
	checkSprayTransparency()
	
	-- Monitor for character changes
	player.CharacterAdded:Connect(function(character)
		task.wait(1)
		checkSprayTransparency()
		
		local body = getPlayerBodyForSpray()
		if body then
			local spray = body:FindFirstChild("Spray")
			if spray and spray:IsA("BasePart") then
				sprayWarnConn = spray:GetPropertyChangedSignal("Transparency"):Connect(checkSprayTransparency)
			end
			
			-- Monitor for spray being added/removed
			body.ChildAdded:Connect(function(child)
				if child.Name == "Spray" and child:IsA("BasePart") then
					checkSprayTransparency()
					if sprayWarnConn then sprayWarnConn:Disconnect() end
					sprayWarnConn = child:GetPropertyChangedSignal("Transparency"):Connect(checkSprayTransparency)
				end
			end)
			
			body.ChildRemoved:Connect(function(child)
				if child.Name == "Spray" then
					checkSprayTransparency()
				end
			end)
		end
	end)
	
	-- Set up monitoring for current character
	local body = getPlayerBodyForSpray()
	if body then
		local spray = body:FindFirstChild("Spray")
		if spray and spray:IsA("BasePart") then
			sprayWarnConn = spray:GetPropertyChangedSignal("Transparency"):Connect(checkSprayTransparency)

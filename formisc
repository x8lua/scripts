local function httpRequest(req)
    if request then return request(req) end
    if http_request then return http_request(req) end
    if syn and syn.request then return syn.request(req) end
    if http and http.request then return http.request(req) end
    if fluxus and fluxus.request then return fluxus.request(req) end
    error("No HTTP request available")
end

local function fetchWithRedirects(url, maxHops)
    local current = url
    for _ = 1, (maxHops or 5) do
        local r = httpRequest({ Url = current, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0", ["Accept"] = "*/*", ["Accept-Encoding"] = "identity", ["Connection"] = "close" } })
        local sc = r and r.StatusCode or 0
        if sc == 301 or sc == 302 or sc == 303 or sc == 307 or sc == 308 then
            local loc
            for k, v in pairs(r.Headers or {}) do if tostring(k):lower() == "location" then loc = v break end end
            if not loc then return r end
            if loc:match("^https?://") then current = loc else local host = current:match("^(https?://[^/]+)") or ""; if loc:sub(1,1) ~= "/" then loc = "/" .. loc end; current = host .. loc end
        else
            return r
        end
    end
    return httpRequest({ Url = current, Method = "GET" })
end

local function sanitize(str)
    str = tostring(str or "")
    str = str:gsub("[%\\/:*?\"<>|]", "_")
    str = str:gsub("%s+", " ")
    str = str:match("^%s*(.-)%s*$") or str
    if str == "" then return nil end
    return str
end


        return
    end

    local TweenService = game:GetService("TweenService")

    staminaWarnGui = Instance.new("ScreenGui")
    staminaWarnGui.Name = "StaminaWarnOverlay"
    staminaWarnGui.IgnoreGuiInset = true
    staminaWarnGui.ResetOnSpawn = false
    staminaWarnGui.Parent = player:WaitForChild("PlayerGui")

    local textLabel = Instance.new("TextLabel")
    textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    textLabel.Position = UDim2.new(0.5, 0, 0.58, 0)
    textLabel.Size = UDim2.new(1.5, 0, 1.5, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextTransparency = 1
    textLabel.Font = Enum.Font.GothamBlack
    textLabel.TextScaled = true
    textLabel.Text = ""
    textLabel.ZIndex = 3
    textLabel.TextStrokeTransparency = 0.8
    textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    textLabel.Parent = staminaWarnGui

    local vignette = Instance.new("ImageLabel")
    vignette.Size = UDim2.new(1, 0, 1, 0)
    vignette.Position = UDim2.new(0, 0, 0, 0)
    vignette.BackgroundTransparency = 1
    vignette.Image = "rbxassetid://3156051342"
    vignette.ImageTransparency = 1
    vignette.ScaleType = Enum.ScaleType.Fit
    vignette.ZIndex = 2
    vignette.Parent = staminaWarnGui

    local lastFlick = 0
    local flickState = false

    local function tweenTextTransparency(val, t)
        TweenService:Create(textLabel, TweenInfo.new(t or 0.1, Enum.EasingStyle.Linear), { TextTransparency = val }):Play()
    end

    local function tweenVignette(val, t)
        TweenService:Create(vignette, TweenInfo.new(t or 0.1, Enum.EasingStyle.Linear), { ImageTransparency = val }):Play()
    end

    staminaWarnConn = RunService.RenderStepped:Connect(function()
        if not staminaWarnEnabled then return end
        local text = staminaLabel.Text or "0/100"
        textLabel.Text = text
        local cur, tot = string.match(text, "(%d+)%s*/%s*(%d+)")
        cur = tonumber(cur) or 0
        tot = tonumber(tot) or 100
        local ratio = math.clamp(tot > 0 and (cur / tot) or 0, 0, 1)
        local threshold = math.clamp((tonumber(staminaWarnThresholdPercent) or 30) / 100, 0.05, 0.9)

        if ratio <= threshold then
            local strength = 1 - (ratio / threshold)
            local txtAlpha = 1 - (0.9 * strength)
            local vigAlpha = 1 - (0.9 * strength)
            tweenTextTransparency(txtAlpha, 0.1)
            tweenVignette(vigAlpha, 0.1)

            local flickInterval = math.clamp((ratio ^ 2.2) * 0.25, 0.03, 0.25)
            if tick() - lastFlick >= flickInterval then
                lastFlick = tick()
                flickState = not flickState
                local targetColor = flickState and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 255, 255)
                TweenService:Create(textLabel, TweenInfo.new(flickInterval / 2, Enum.EasingStyle.Quad), { TextColor3 = targetColor }):Play()
            end
        else
            tweenTextTransparency(1, 0.2)
            tweenVignette(1, 0.3)
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    end)

    Library:Notify({ Title = "Stamina Warning", Description = "Enabled (no shakes)", Time = 3 })
end


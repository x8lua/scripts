end

local function applyCustom(soundObj, path)
    if not soundObj or not path or path == "" or not isfile(path) then return end
    local tp = soundObj.TimePosition
    local was = soundObj.Playing
    local id = assetFromFile(path)
    if id and id ~= "" then soundObj.SoundId = id; soundObj.TimePosition = tp; if was then soundObj:Play() end end
end

local function restoreLMS(soundObj)
    if not soundObj then return end
    local tp = soundObj.TimePosition
    local was = soundObj.Playing
    soundObj.SoundId = "rbxassetid://" .. LMS_TARGET_ID
    soundObj.Volume = 0.5

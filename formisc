    setSlowedStatusLabelText(("Modified SlowedStatus: %.3f"):format(slowedStatusValue.Value))
end

local function applyAntiSlownessOnce()
    if not antiSlownessEnabled then return end
    slowedStatusValue = slowedStatusValue or findSlowedStatusValue()
    local target = slowedStatusValue
    if target and type(target.Value) == "number" then
        local current = target.Value
        local multiplier = 1 + (tonumber(antiSlownessPercent) or 0) / 100
        local adjusted = current * multiplier
        if adjusted > 1 then adjusted = 1 end
        if adjusted ~= current then
            antiSlownessInternalWrite = true
            target.Value = adjusted
            task.defer(function()
                antiSlownessInternalWrite = false
            end)
        end
    end
    updateSlowedStatusLabel()
end

local function connectAntiSlowness()
    if antiSlownessConn then antiSlownessConn:Disconnect() antiSlownessConn = nil end
    if antiSlownessChildAddedConn then antiSlownessChildAddedConn:Disconnect() antiSlownessChildAddedConn = nil end
    if antiSlownessChildRemovedConn then antiSlownessChildRemovedConn:Disconnect() antiSlownessChildRemovedConn = nil end

    slowedStatusValue = findSlowedStatusValue()

    local ok, parentFolder = pcall(function()
        local character = player and player.Character
        if not character then return nil end
        return character:FindFirstChild("SpeedMultipliers")
    end)

    if ok and parentFolder then
        antiSlownessChildAddedConn = parentFolder.ChildAdded:Connect(function(child)
            if child.Name == "SlowedStatus" then
                slowedStatusValue = child
                if antiSlownessConn then antiSlownessConn:Disconnect() antiSlownessConn = nil end
                antiSlownessConn = slowedStatusValue:GetPropertyChangedSignal("Value"):Connect(function()
                    if antiSlownessInternalWrite then return end
                    applyAntiSlownessOnce()
                end)
                applyAntiSlownessOnce()
                updateSlowedStatusLabel()
            end
        end)
        antiSlownessChildRemovedConn = parentFolder.ChildRemoved:Connect(function(child)
            if child == slowedStatusValue then
                if antiSlownessConn then antiSlownessConn:Disconnect() antiSlownessConn = nil end
                slowedStatusValue = nil
                updateSlowedStatusLabel()
            end
        end)
    end

    if not slowedStatusValue then
        updateSlowedStatusLabel()
        return
    end
    antiSlownessConn = slowedStatusValue:GetPropertyChangedSignal("Value"):Connect(function()
        if antiSlownessInternalWrite then return end
        applyAntiSlownessOnce()
    end)
    applyAntiSlownessOnce()
end

local function startAntiSlowness()
    if antiSlownessEnabled then return end
    antiSlownessEnabled = true
    connectAntiSlowness()
    task.spawn(function()
        while antiSlownessEnabled do
            task.wait(0.5)
            if not slowedStatusValue or not slowedStatusValue.Parent then
                connectAntiSlowness()
            else
                updateSlowedStatusLabel()
            end
        end
    end)
end

local function stopAntiSlowness()
    antiSlownessEnabled = false
    if antiSlownessConn then antiSlownessConn:Disconnect() antiSlownessConn = nil end
    if antiSlownessChildAddedConn then antiSlownessChildAddedConn:Disconnect() antiSlownessChildAddedConn = nil end
    if antiSlownessChildRemovedConn then antiSlownessChildRemovedConn:Disconnect() antiSlownessChildRemovedConn = nil end
    slowedStatusValue = nil
    updateSlowedStatusLabel()
end


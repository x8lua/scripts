local function getAngleBetweenVectors(a, b)
    local dot = a:Dot(b)
    dot = math.clamp(dot, -1, 1)
    return math.deg(math.acos(dot))
end

local function isInFrontOfKiller(playerPos, killerPos, killerLookVector)
    local toPlayer = (playerPos - killerPos).Unit
    local angle = getAngleBetweenVectors(killerLookVector, toPlayer)
    return angle < 90
end

local function fireDagger()
    local t = tick()
    if t - lastQPressTime < 0.5 then return false end
    local ok, btn = pcall(function()
        return player:WaitForChild("PlayerGui", 5):WaitForChild("MainUI", 5):WaitForChild("AbilityContainer", 5):WaitForChild("Dagger", 5)
    end)
    if ok and btn then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        lastQPressTime = t
        return true
    end
    return false
end

local function verifyTwoTimeCharacter()
    local character = player.Character
    if not character then return false end
    local survivorsFolder = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Survivors")
    local twoTime = survivorsFolder and survivorsFolder:FindFirstChild("TwoTime")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not twoTime then return false end
    local twoTimeHum = twoTime:FindFirstChildOfClass("Humanoid")
    if twoTimeHum and humanoid == twoTimeHum then return true end
    if character:IsDescendantOf(twoTime) then return true end
    if humanoid and humanoid:IsDescendantOf(twoTime) then return true end
    if character.Name == "TwoTime" then return true end
    if player.Name == "TwoTime" then return true end
    return false
end

local function startKillerDetector()
    if killerConn then killerConn:Disconnect() killerConn = nil end
    killerConn = RunService.Heartbeat:Connect(function()
        if not killerDetectorActive then return end
        if not verifyTwoTimeCharacter() then return end
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local killersFolder = getKillersFolder()
        if not killersFolder then return end
        local playerPos = root.Position
        local playerLook = root.CFrame.LookVector
        local closestDist = math.huge
        for _, killerName in ipairs(KILLER_NAMES) do
            local killerModel = killersFolder:FindFirstChild(killerName)
            if killerModel then
                local killerRoot = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("Torso")
                if killerRoot then
                    local killerPos = killerRoot.Position
                    local dist = (playerPos - killerPos).Magnitude
                    if dist < closestDist then closestDist = dist end
                    if dist <= detectionRange then
                        local killerLook = killerRoot.CFrame.LookVector
                        local angle = getAngleBetweenVectors(playerLook, killerLook)
                        local inFront = isInFrontOfKiller(playerPos, killerPos, killerLook)
                        if angle <= ANGLE_THRESHOLD and not inFront then fireDagger() end
                    end
                end
            end
        end
    end)
end


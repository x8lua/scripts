	for sound, originalData in pairs(originalGunshotSounds) do
		if
			sound
			and sound.Parent
			and isTargetGunshotSound(originalData.soundId)
		then
			restoreOriginalGunshotSound(sound)
		end
	end
	-- Clear the storage after restoration
	originalGunshotSounds = {}
end


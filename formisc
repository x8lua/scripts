Tabs.Settings:CreateSection('🗑️ Remove Gunshot Sounds')

Tabs.Settings:CreateParagraph('GunshotRemoveInfo', {
	Title = 'Remove saved gunshot sounds',
	Content = 'Select a saved gunshot sound from the dropdown and click remove to delete it permanently from your saved sounds list.',
})

	-- Note: removeGunshotSound and updateRemoveDropdownOptions are now defined in the shared section above MISC TAB

-- Variable for remove sound selection
local gunshotRemoveSelection = ''

-- Remove Sound Dropdown
		UI.GunshotRemoveDropdown =
			Tabs.Settings:CreateDropdown('RemoveGunshotSound', {
	Title = 'Select Sound to Remove',
	Description = 'Choose a saved sound to delete',
	Values = { 'Select Sound to Remove' },
	Multi = false,
	Default = 1,
	Callback = function(Value)
		gunshotRemoveSelection = Value or ''
	end,
})

-- Remove Button
UI.GunshotRemoveButton = Tabs.Settings:CreateButton({
	Title = '🗑️ Remove Selected Sound',
	Description = 'Permanently delete the selected sound from saved list',
	Callback = function()
		if
			gunshotRemoveSelection == ''
			or gunshotRemoveSelection == 'Select Sound to Remove'
		then
			Library:Notify({
				Title = '⚠️ Warning',
				Content = 'Please select a sound to remove first',
				Duration = 3,
			})
			return
		end

		local success, message = removeGunshotSound(gunshotRemoveSelection)

		if success then
			Library:Notify({
				Title = '✅ Success',
				Content = message,
				Duration = 3,
			})

			-- Reset selection
			gunshotRemoveSelection = ''
		else
			Library:Notify({
				Title = '❌ Error',
				Content = message,
				Duration = 5,
			})
		end
	end,
})


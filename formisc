local function customMusicTryReplaceSound(sound, target, name)
	if not target.IsEnabled then return false end
	
	if sound:IsA("Sound") and sound.SoundId == target.Original then
		local customSound
		if type(target.Custom) == "table" and #target.Custom > 0 then
			local randomIndex = math.random(1, #target.Custom)
			customSound = target.Custom[randomIndex]
			customMusicLog(string.format("Replaced %s (variant %d/%d)", name, randomIndex, #target.Custom))
		elseif target.Custom then
			customSound = target.Custom
			customMusicLog(string.format("Replaced %s", name))
		else
			return false
		end
		sound.SoundId = customSound
		return true
	end
	return false
end

local function customMusicTryRevertSound(sound, target, name)
	if sound:IsA("Sound") then
		local shouldRevert = false
		if type(target.Custom) == "table" then
			for _, customVariant in ipairs(target.Custom) do
				if sound.SoundId == customVariant then
					shouldRevert = true
					break
				end
			end
		elseif target.Custom and sound.SoundId == target.Custom then
			shouldRevert = true
		end
		
		if shouldRevert then
			sound.SoundId = target.Original
			customMusicLog(string.format("Reverted %s", name))
			return true
		end
	end
	return false
end

local function customMusicEnableReplacement(name, target)
	customMusicLog(string.format("Enabling %s replacement", name))
	
	if not target.Folder then
		customMusicLog(string.format("ERROR: Folder not found for %s", name))
		Library:Notify({ Title = "Custom Music", Description = name .. " folder not found", Time = 3 })
		return
	end
	
	if not target.Custom or (type(target.Custom) == "table" and #target.Custom == 0) then
		customMusicLog(string.format("ERROR: No custom audio loaded for %s", name))
		Library:Notify({ Title = "Custom Music", Description = name .. " audio not loaded", Time = 3 })
		return
	end
	
	target.IsEnabled = true
	
	task.spawn(function()
		local count = 0
		for _, descendant in ipairs(target.Folder:GetDescendants()) do
			if customMusicTryReplaceSound(descendant, target, name) then
				count = count + 1
			end
		end
		if count > 0 then
			customMusicLog(string.format("Replaced %d sound(s) for %s", count, name))
		end
	end)
	
	target.Watcher = target.Folder.DescendantAdded:Connect(function(descendant)
		task.wait()

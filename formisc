local guest1337Connection = nil

local function checkAndWaitForGuest1337()
    -- Check if current character is Guest1337
    local currentChar = player.Character
    if currentChar and currentChar.Name == "Guest1337" then
        return -- Already Guest1337, no need to wait
    end
    
    -- Not Guest1337, show notification
    Library:Notify({ Title = "Waiting for Guest1337", Description = "Waiting for character to respawn as Guest1337...", Time = 5 })
end

-- Setup respawn-safe check
local function setupGuest1337Check()
    -- Clean up existing connection
    if guest1337Connection then
        guest1337Connection:Disconnect()
        guest1337Connection = nil
    end
    
    -- Check initial character
    checkAndWaitForGuest1337()
    
    -- Listen for character respawns
    guest1337Connection = player.CharacterAdded:Connect(function(character)
        task.wait(0.1) -- Small delay to ensure character is fully loaded
        if character.Name == "Guest1337" then
            Library:Notify({ Title = "Guest1337 Detected", Description = "Character is now Guest1337!", Time = 3 })
        else
            -- Not Guest1337, show waiting notification
            Library:Notify({ Title = "Waiting for Guest1337", Description = "Waiting for character to respawn as Guest1337...", Time = 5 })
        end
    end)
end

-- Run the check (respawn safe)
task.spawn(setupGuest1337Check)


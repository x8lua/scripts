-- KILLER DETECTION & AUTO DAGGER
-- ========================================
-- Features:
-- ✅ Auto-fires Dagger ability when conditions are met
-- ✅ TwoTime character verification (auto-disables if not TwoTime)
-- ✅ Adjustable detection range (distance to killer)
-- ✅ Adjustable angle threshold (direction accuracy)
-- ✅ Real-time distance display to closest killer
-- ✅ Debug mode with detailed console output
-- ✅ Only triggers when behind killer (not in front)
-- ✅ Respawn-safe with auto-restart
-- ========================================
		do -- Isolated scope for Killer Detection
Tabs.Misc:CreateSection('🎯 Killer Detection')

Tabs.Misc:CreateParagraph('KillerDetectorInfo', {
	Title = 'Auto Dagger when killers are nearby',
	Content = 'Detects nearby killers and fires Dagger ability when looking in the same direction (behind killer only). Only works for TwoTime character. Will auto-disable if character verification fails.',
})

-- Killer Detection Configuration
local KILLER_NAMES = { '1x1x1x1', 'Noli', 'JohnDoe', 'c00lkidd', 'Slasher' }
local ANGLE_THRESHOLD = 50 -- degrees
local COOLDOWN_TIME = 0.5

-- Killer Detection State
local killerDetectorActive = false
local lastQPressTime = 0
local detectionRange = 30
local detectionConnection = nil
local debugMode = false
local closestKillerDistance = 0
local closestKillerName = 'None'
local killerDebugData = {}

-- Helper function to get angle between two vectors
local function getAngleBetweenVectors(v1, v2)
	local dotProduct = v1.Unit:Dot(v2.Unit)
	dotProduct = math.clamp(dotProduct, -1, 1)
	local angleRadians = math.acos(dotProduct)
	return math.deg(angleRadians)
end

-- Helper function to check if player is in front of killer
local function isInFrontOfKiller(playerPos, killerPos, killerLookVector)
	local toPlayer = (playerPos - killerPos).Unit
	local angle = getAngleBetweenVectors(killerLookVector, toPlayer)
	return angle < 90 -- If angle is less than 90 degrees, player is in front
end

-- Helper function to fire Dagger ability
local function fireDagger()
	local currentTime = tick()
	if currentTime - lastQPressTime >= COOLDOWN_TIME then
		local success, daggerButton = pcall(function()
			return player
				:WaitForChild('PlayerGui', 5)
				:WaitForChild('MainUI', 5)
				:WaitForChild('AbilityContainer', 5)
				:WaitForChild('Dagger', 5)
		end)

		if success and daggerButton then
			pcall(function()
				firesignal(daggerButton.MouseButton1Click)
			end)
			lastQPressTime = currentTime
			return true
		end
		return false
	end
	return false
end

-- Helper function to verify TwoTime character
local function verifyTwoTimeCharacter()
	local character = player.Character
	if not character then
		return false
	end

	local survivorsFolder = workspace:FindFirstChild('Players')
		and workspace.Players:FindFirstChild('Survivors')
	local twoTime = survivorsFolder
		and survivorsFolder:FindFirstChild('TwoTime')
	local humanoid = character:FindFirstChildOfClass('Humanoid')

	if not twoTime then
		return false
	end

	local twoTimeHum = twoTime:FindFirstChildOfClass('Humanoid')

	-- Method 1: Direct humanoid match
	if twoTimeHum and humanoid == twoTimeHum then
		return true
	end

	-- Method 2: Character is descendant of TwoTime
	if character:IsDescendantOf(twoTime) then
		return true
	end

	-- Method 3: Humanoid is descendant of TwoTime
	if humanoid and humanoid:IsDescendantOf(twoTime) then
		return true
	end

	-- Method 4: Check if character name matches TwoTime
	if character.Name == 'TwoTime' then
		return true
	end

	-- Method 5: Check if player name matches TwoTime
	if player.Name == 'TwoTime' then
		return true
	end

	return false
end

-- Main detection function
local function checkForKillers()
	if not killerDetectorActive then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local humanoidRootPart = character:FindFirstChild('HumanoidRootPart')
	if not humanoidRootPart then
		return
	end

	-- Check if player is TwoTime
	if not verifyTwoTimeCharacter() then
		if debugMode then
			print('❌ Not playing as TwoTime - disabling detector')
		end
		-- Auto-disable the toggle
		killerDetectorActive = false
		if Options.KillerDetector then
			Options.KillerDetector:SetValue(false)
		end
		Library:Notify({
			Title = '⚠️ Character Verification Failed',
			Content = 'You are not playing as TwoTime. Auto Dagger disabled.',
			Duration = 5,
		})
		return
	end

	local playerPos = humanoidRootPart.Position
	local playerLookVector = humanoidRootPart.CFrame.LookVector

	-- Check if workspace.Players.Killers exists
	local killersFolder = workspace:FindFirstChild('Players')
	if killersFolder then
		killersFolder = killersFolder:FindFirstChild('Killers')
	end

	if not killersFolder then
		closestKillerDistance = 0
		closestKillerName = 'None'
		return
	end

	-- Track closest killer for debug
	local closestDist = math.huge
	local closestName = 'None'

	-- Clear previous debug data
	killerDebugData = {}

	-- Check each killer model
	for _, killerName in ipairs(KILLER_NAMES) do
		local killerModel = killersFolder:FindFirstChild(killerName)
		if killerModel then
					local killerRoot = killerModel:FindFirstChild(
						'HumanoidRootPart'
					) or killerModel:FindFirstChild('Torso')
			if killerRoot then
				local killerPos = killerRoot.Position
				local distance = (playerPos - killerPos).Magnitude

				-- Track closest killer (always update regardless of range)
				if distance < closestDist then
					closestDist = distance
					closestName = killerName
				end

				local killerLookVector = killerRoot.CFrame.LookVector

				-- Check if looking in the same direction
						local angle = getAngleBetweenVectors(
							playerLookVector,
							killerLookVector
						)

				-- Check if NOT in front of killer
						local inFront = isInFrontOfKiller(
							playerPos,
							killerPos,
							killerLookVector
						)

				-- Store debug data for GUI display (always, regardless of debug mode)
				table.insert(killerDebugData, {
					name = killerName,
					distance = distance,
					angle = angle,
					inFront = inFront,
					inRange = distance <= detectionRange,
				})

				-- Debug mode: show ALL killers detected in console
				if debugMode then
					print(
						string.format(
							'🔍 DEBUG | Killer: %s | Distance: %.1f | Angle: %.1f° | InFront: %s | InRange: %s',
							killerName,
							distance,
							angle,
							tostring(inFront),
							tostring(distance <= detectionRange)
						)
					)
				end

				-- Check if within range for auto-dagger
				if distance <= detectionRange then
					if angle <= ANGLE_THRESHOLD and not inFront then
						local pressed = fireDagger()
						if pressed then
							print(
								string.format(
									'✅ DAGGER FIRED! Killer: %s | Distance: %.1f studs | Angle: %.1f°',
									killerName,
									distance,
									angle
								)
							)
						end
						-- Update closest killer info before returning
						closestKillerDistance = distance
						closestKillerName = killerName
						return
					end
				end
			end
		end
	end

	-- Update closest killer info (always update at the end)
	closestKillerDistance = closestDist == math.huge and 0 or closestDist
	closestKillerName = closestName
end

-- Start killer detection
local function startKillerDetection()
	if detectionConnection then
		detectionConnection:Disconnect()
		detectionConnection = nil
	end

	detectionConnection = RunService.Heartbeat:Connect(function()
		if killerDetectorActive then

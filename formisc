-- Normalize asset ID string to its numeric ID (similar to reference script)
local function normalizeAssetId(idStr)
    if type(idStr) ~= "string" then 
        return nil 
    end
    return string.match(idStr, "%d+")
end

-- Animation tracking system (event-based)
local animationTrackingState = {} -- [character] = { [normalizedAnimId] = true/false }
local monitoredCharacters = setmetatable({}, { __mode = "k" })

-- Create animation detection handler for a character
local function createAnimationHandler(character)
    return function(animationTrack)
        if not animationTrack or not animationTrack.Animation then 
            return 
        end
        
        local playedId = normalizeAssetId(tostring(animationTrack.Animation.AnimationId))
        if not playedId then 
            return 
        end
        
        -- Initialize state for this character if needed
        if not animationTrackingState[character] then
            animationTrackingState[character] = {}
        end
        
        -- Track when animation starts playing
        animationTrackingState[character][playedId] = true
        
        -- Track when animation stops
        local stoppedConnection
        stoppedConnection = animationTrack.Stopped:Connect(function()
            if animationTrackingState[character] then
                animationTrackingState[character][playedId] = false
            end
            if stoppedConnection then
                stoppedConnection:Disconnect()
            end
        end)
    end
end

-- Set up monitoring for a character
local function setupCharacter(character)
    if monitoredCharacters[character] then 
        return 
    end
    monitoredCharacters[character] = true
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        -- Wait for animator to be added
        local connection
        connection = humanoid.ChildAdded:Connect(function(child)
            if child:IsA("Animator") then
                local onAnimationPlayed = createAnimationHandler(character)
                child.AnimationPlayed:Connect(onAnimationPlayed)
                connection:Disconnect()
            end
        end)
    else
        local onAnimationPlayed = createAnimationHandler(character)
        animator.AnimationPlayed:Connect(onAnimationPlayed)
    end
end


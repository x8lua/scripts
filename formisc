		-- Function to get combo sound path
		local function getComboSoundPath(comboNum, isPower)
			-- Map combo counter to actual sound numbers
			-- Success: 1,2,4,6,8,10,12,14,16 (more gradual progression)
			-- Failed: 1-16 (keeps all power sounds for variety)
			local actualNum = comboNum
			if not isPower then
				-- Success sound mapping
				local successMap = { 1, 2, 4, 6, 8, 10, 12, 14, 16 }
				actualNum = successMap[math.min(comboNum, #successMap)]
			end

			if isPower then
				return string.format(
					'forvids/sfx/combo/combo_%d_power.ogg',
					actualNum
				)
			else
				return string.format('forvids/sfx/combo/combo_%d.ogg', actualNum)
			end
		end

		-- Function to replace sound with Zenith combo sound
		local function replaceWithZenithCombo(sound, isSuccess)
			local parent = sound.Parent
			if not parent then
				return
			end

			local wasPlaying = sound.Playing
			local currentComboType = isSuccess and 'success' or 'failed'

			-- Check if combo type changed (success -> failed or failed -> success)
			if lastComboType and lastComboType ~= currentComboType then
				-- Combo broke! Reset counter
				comboCounter = 0
				print(
					string.format(
						'💥 Combo broke! Switched from %s to %s - Counter reset',
						lastComboType,
						currentComboType
					)
				)
			end

			-- Update last combo type
			lastComboType = currentComboType

			-- Increment combo counter (1-16 range, STICK at 16 when reached)
			comboCounter = comboCounter + 1
			if comboCounter > 16 then
				comboCounter = 16 -- Stay at 16 instead of cycling
				print('🏆 Max combo reached! Staying at 16')
			end

			-- Choose sound based on success/failed
			local soundPath = getComboSoundPath(comboCounter, not isSuccess) -- failed uses power

			-- Destroy the original sound
			sound:Destroy()

			-- Create new sound with combo sound
			local newSound = Instance.new('Sound')
			newSound.SoundId = getcustomasset(soundPath)
			newSound.Volume = zenithComboVolume
			newSound.Parent = parent

			local statusEmoji = isSuccess and '✅' or '❌'
			local comboType = isSuccess and 'regular' or 'power'
			print(
				string.format(
					'%s Zenith Combo #%d (%s): %s',
					statusEmoji,
					comboCounter,
					comboType,
					soundPath
				)
			)

			-- Play the sound if original was playing
			if wasPlaying then
				newSound:Play()
			end

			-- Clean up when done
			newSound.Ended:Connect(function()
				if newSound and newSound.Parent then
					newSound:Destroy()
				end
			end)
		end


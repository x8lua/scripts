		-- Camera shake function for health loss
		local function cameraShake(intensity, duration)
			task.spawn(function()
				local camera = workspace.CurrentCamera
				if not camera then
					return
				end

				local startTime = tick()
				local shakeValue = Instance.new('NumberValue')
				shakeValue.Value = intensity

				-- Fade out tween for intensity
				local fadeTween = TweenService:Create(
					shakeValue,
					TweenInfo.new(
						duration,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),
					{ Value = 0 }
				)
				fadeTween:Play()

				local conn
				conn = RunService.RenderStepped:Connect(function()
					local elapsed = tick() - startTime
					if elapsed >= duration then
						conn:Disconnect()
						shakeValue:Destroy()
						return
					end

					local currentIntensity = shakeValue.Value
					local shake = CFrame.new(
						math.random() * currentIntensity * 2 - currentIntensity,
						math.random() * currentIntensity * 2 - currentIntensity,
						math.random() * currentIntensity * 2 - currentIntensity
					) * CFrame.Angles(
						math.rad(
							math.random() * currentIntensity * 10 - currentIntensity * 5
						),
						math.rad(
							math.random() * currentIntensity * 10 - currentIntensity * 5
						),
						math.rad(
							math.random() * currentIntensity * 10 - currentIntensity * 5
						)
					)

					camera.CFrame = camera.CFrame * shake
				end)
			end)
		end


            continue 
        end
        
        -- Check all Sound objects in HumanoidRootPart against database
        local soundFound = false
        local detectedPlayerName = nil
        
        for _, child in ipairs(humanoidRootPart:GetChildren()) do
            if child:IsA("Sound") then
                local soundIdString = tostring(child.SoundId)
                if BLOCK_SOUND_SET[soundIdString] then
                    soundFound = true
                    detectedPlayerName = BLOCK_SOUND_DATABASE[soundIdString] or playerName
                    break
                end
            end
        end
        
        -- Initialize player state if not exists
        if not detectedPlayers[playerName] then
            detectedPlayers[playerName] = {
                lastDetected = false,
                lastSpawnTime = 0,
                detectionStartTime = 0
            }
        end
        
        local playerState = detectedPlayers[playerName]
        
        if soundFound then
            if not playerState.lastDetected then
                print("detected sound for", playerName)
                playerState.lastDetected = true
                playerState.lastSpawnTime = currentTime
                playerState.detectionStartTime = currentTime
                createHitbox(targetPlayer, detectedPlayerName) -- Create first hitbox immediately
            end
            
            -- Check if we should still create hitboxes (within 0.7 seconds of detection start)
            local timeSinceDetectionStart = currentTime - playerState.detectionStartTime
            if timeSinceDetectionStart <= HITBOX_CREATION_DURATION then
                -- Create new hitbox every 0.05 seconds (only if within creation duration)
                if currentTime - playerState.lastSpawnTime >= HITBOX_SPAWN_INTERVAL then
                    createHitbox(targetPlayer, detectedPlayerName)
                    playerState.lastSpawnTime = currentTime
                end
            end
        else
            -- Sound not found, stop creating new hitboxes for this player
            if playerState.lastDetected then
                playerState.lastDetected = false
                playerState.lastSpawnTime = 0
                playerState.detectionStartTime = 0
            end
        end
    end
    
    -- Clean up state for players that no longer exist
    for playerName, _ in pairs(detectedPlayers) do
        if not activePlayerNames[playerName] then
            detectedPlayers[playerName] = nil
        end
    end
end


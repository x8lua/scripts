-- CHAMS SYSTEM (Highlight-based, self-cleaning)
-- ========================================

local DefaultFillColor      = Color3.fromRGB(175, 25, 255)
local SurvivorFillColor     = Color3.fromRGB(60, 255, 120)
local KillerFillColor       = Color3.fromRGB(255, 70, 70)
local DepthMode             = Enum.HighlightDepthMode.AlwaysOnTop
local OutlineColor          = Color3.fromRGB(255, 255, 255)
local OutlineTransparency   = 0
local chamsFadeDuration     = 0.5
local chamsLastingTime      = 3
local chamsCooldownTime     = 2
local chamsVisibleTransparency = 0.5
local chamsActive           = false

--// SERVICES
local CoreGui         = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService    = game:GetService("TweenService")

--// STORAGE FOR HIGHLIGHTS
local Storage

--// FOLDERS WITH TARGET MODELS
local wsPlayers = workspace:WaitForChild("Players")
local Survivors = wsPlayers:WaitForChild("Survivors")
local Killers   = wsPlayers:WaitForChild("Killers")

--// TRACKED DATA
local modelData = {}      -- [Model] = {highlight = Highlight, connections = {RBXConnections}}
local folderConnections = {}
local chamsInputConnection

local function ensureStorage()
	if Storage and Storage.Parent then
		return
	end
	Storage = Instance.new("Folder")
	Storage.Name = "Highlight_Storage"
	Storage.Parent = CoreGui
end

local function tweenHighlight(highlight, targetFill, targetOutline, destroyOnComplete, duration)
	if not highlight then
		return
	end

	local time = duration or chamsFadeDuration
	if time <= 0 then
		highlight.FillTransparency = targetFill
		highlight.OutlineTransparency = targetOutline
		if destroyOnComplete and highlight.Parent then
			highlight:Destroy()
		end
		return
	end

	local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	local tween = TweenService:Create(highlight, tweenInfo, {
		FillTransparency = targetFill,
		OutlineTransparency = targetOutline
	})

	if destroyOnComplete then
		tween.Completed:Connect(function()
			if highlight.Parent then
				highlight:Destroy()
			end
		end)
	end

	tween:Play()
end

local function setHighlightVisibility(data, visible)
	if not data or not data.highlight then
		return
	end

	data.isVisible = visible

	if visible then
		tweenHighlight(data.highlight, chamsVisibleTransparency, OutlineTransparency, false)
	else
		tweenHighlight(data.highlight, 1, 1, false)
	end
end

local function startHighlightCycle(model, data)
	if data.cycleThread then
		return
	end

	data.cycleThread = task.spawn(function()
		while chamsActive and modelData[model] == data and not data.cancelled do
			setHighlightVisibility(data, true)

			if chamsLastingTime > 0 then
				task.wait(chamsLastingTime)
			else
				task.wait()
			end

			if not (chamsActive and modelData[model] == data and not data.cancelled) then
				break
			end

			setHighlightVisibility(data, false)

			if chamsCooldownTime > 0 then
				task.wait(chamsCooldownTime)
			else
				task.wait()
			end
		end
	end)
end

local function removeHighlight(model, data, instant)
	if not data then
		return
	end

	data.cancelled = true

	if data.connections then
		for _, con in ipairs(data.connections) do
			if con and con.Connected then
				con:Disconnect()
			end
		end
	end

	if data.highlight then
		local highlight = data.highlight
		data.highlight = nil

		if instant then
			if highlight.Parent then
				highlight:Destroy()
			end
		else
			tweenHighlight(highlight, 1, 1, true)
		end
	end

	modelData[model] = nil
end

--// ADD CHAMS TO ONE MODEL
local function addChamsToModel(model)
	if not chamsActive then
		return
	end

	if not model or not model:IsA("Model") then
		return
	end
	if modelData[model] then
		return -- already highlighted
	end

	ensureStorage()

	local highlight = Instance.new("Highlight")
	highlight.Name = model.Name
	if model:IsDescendantOf(Killers) then
		highlight.FillColor = KillerFillColor
	elseif model:IsDescendantOf(Survivors) then
		highlight.FillColor = SurvivorFillColor
	else
		highlight.FillColor = DefaultFillColor
	end
	highlight.DepthMode = DepthMode
	highlight.FillTransparency = 1
	highlight.OutlineColor = OutlineColor
	highlight.OutlineTransparency = 1
	highlight.Adornee = model
	highlight.Parent = Storage

	local data = {
		highlight = highlight,
		connections = {},
		isVisible = false,
		cancelled = false
	}

	-- when this model is removed from the game, remove its highlight
	data.connections[#data.connections + 1] = model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removeHighlight(model, data)
		end
	end)

	modelData[model] = data

	startHighlightCycle(model, data)
end

local function disconnectFolderConnections()
	for _, con in ipairs(folderConnections) do
		if con and con.Connected then
			con:Disconnect()
		end
	end
	table.clear(folderConnections)
end

local function stopChams(destroyScript)
	if not chamsActive and not destroyScript then
		return
	end

	chamsActive = false

	for model, data in pairs(modelData) do
		removeHighlight(model, data, destroyScript)
	end
	table.clear(modelData)

	disconnectFolderConnections()

	if chamsInputConnection then
		chamsInputConnection:Disconnect()
		chamsInputConnection = nil
	end

	if Storage then
		if destroyScript or chamsFadeDuration <= 0 then
			Storage:Destroy()
		else
			task.delay(chamsFadeDuration, function()
				if Storage then
					Storage:Destroy()
				end
			end)
		end
		Storage = nil
	end

	if destroyScript and script and script.Parent then
		script:Destroy()
	end
end

local function startChams()
	if chamsActive then
		return
	end

	chamsActive = true
	ensureStorage()

	--// INITIAL SCAN
	for _, m in ipairs(Survivors:GetChildren()) do
		addChamsToModel(m)
	end
	for _, m in ipairs(Killers:GetChildren()) do
		addChamsToModel(m)
	end

	--// LISTEN FOR NEW MODELS
	folderConnections[#folderConnections + 1] = Survivors.ChildAdded:Connect(addChamsToModel)
	folderConnections[#folderConnections + 1] = Killers.ChildAdded:Connect(addChamsToModel)

	--// TOGGLE: PRESS P TO REMOVE ALL CHAMS & DESTROY SCRIPT
	chamsInputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.P then
			stopChams(true)
		end
	end)
end


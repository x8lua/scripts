		-- Function to handle sound detection
		local function handleSound(sound)
			if not sound:IsA('Sound') then
				return
			end
			if not pitchingActive then
				return
			end

			-- Wait a moment for SoundId to be set
			task.wait()

			local soundId = sound.SoundId

			-- Ignore our own replaced sounds (they don't break or continue streaks)
			if
				soundId == SUCCESS_REPLACEMENT_SOUND
				or soundId == FAILED_REPLACEMENT_SOUND
			then
				debugPrint('🔇 Ignoring our own replacement sound')
				return
			end

			-- Check if it's a success sound
			if isSuccessSound(soundId) then
				-- Check if this is consecutive success sound
				if lastSoundType == 'success' then
					-- Consecutive success, increment pitch
					currentPitchSuccess = currentPitchSuccess + PITCH_INCREMENT
					debugPrint(
						'🔼 Consecutive success! Pitch increased to: '
							.. string.format('%.1f', currentPitchSuccess)
					)
				elseif lastSoundType == 'failed' then
					-- Switched from failed to success, reset success pitch
					currentPitchSuccess = 1.0
					debugPrint(
						'🔄 Switched from failed to success, pitch reset to 1.0'
					)
				else
					-- First success sound or after 'other', reset to 1.0
					currentPitchSuccess = 1.0
					debugPrint('🔄 New success sequence, pitch reset to 1.0')
				end

				debugPrint('')
				debugPrint(
					'╔════════════════════════════════════════╗'
				)
				debugPrint('║   ✅ SUCCESS SOUND DETECTED            ║')
				debugPrint(
					'╚════════════════════════════════════════╝'
				)
				debugPrint('Sound ID: ' .. soundId)
				debugPrint('Sound Parent: ' .. tostring(sound.Parent))
				debugPrint(
					'Current pitch: ' .. string.format('%.1f', currentPitchSuccess)
				)
				debugPrint('')

				-- Replace with success sound
				replaceSoundWithSuccess(sound)

				debugPrint(
					'╚════════════════════════════════════════╝'
				)
				debugPrint('')

				-- Update last sound type
				lastSoundType = 'success'

			-- Check if it's a failed sound
			elseif isFailedSound(soundId) then
				-- Check if this is consecutive failed sound
				if lastSoundType == 'failed' then
					-- Consecutive failed, increment pitch
					currentPitchFailed = currentPitchFailed + PITCH_INCREMENT
					debugPrint(
						'🔼 Consecutive failure! Pitch increased to: '
							.. string.format('%.1f', currentPitchFailed)
					)
				elseif lastSoundType == 'success' then
					-- Switched from success to failed, reset failed pitch
					currentPitchFailed = 1.0
					debugPrint(
						'🔄 Switched from success to failed, pitch reset to 1.0'
					)
				else
					-- First failed sound or after 'other', reset to 1.0
					currentPitchFailed = 1.0
					debugPrint('🔄 New failure sequence, pitch reset to 1.0')
				end

				debugPrint('')
				debugPrint(
					'╔════════════════════════════════════════╗'
				)
				debugPrint('║   ❌ FAILED SOUND DETECTED             ║')
				debugPrint(
					'╚════════════════════════════════════════╝'
				)
				debugPrint('Sound ID: ' .. soundId)
				debugPrint('Sound Parent: ' .. tostring(sound.Parent))
				debugPrint(
					'Current pitch: ' .. string.format('%.1f', currentPitchFailed)
				)
				debugPrint('')

				-- Replace with failed sound
				replaceSoundWithFailed(sound)

				debugPrint(
					'╚════════════════════════════════════════╝'
				)
				debugPrint('')

				-- Update last sound type
				lastSoundType = 'failed'
			else
				-- Other sound detected, but DON'T break the streak
				-- Only target sounds (success/failed) break each other's streaks
				debugPrint('🔊 Other sound detected (ignored, streak continues)')
			end
		end


local function scanFolder(path, out)
    table.clear(out)
    if not isfolder(path) then return end
    for _, filePath in ipairs(listfiles(path)) do
        local fileName = filePath:match("([^/\\]+)$")
        for _, ext in ipairs(supportedAudioFormats) do
            if fileName:lower():match(ext .. "$") then table.insert(out, filePath) break end
        end
    end
end

local function scanLMSFiles() scanFolder(lmsFolderName, lmsFiles) end
local function scanLobbyFiles() scanFolder(lobbyFolderName, lobbyFiles) end

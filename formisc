-- function to apply LMS custom sound
local function applyLMSCustomSound(soundObj)
	if not soundObj or not soundObj:IsA('Sound') then
		return
	end
	if selectedLMSPath == '' or not isfile(selectedLMSPath) then
		return
	end

	local success, err = pcall(function()
		local timePosition = soundObj.TimePosition
		local wasPlaying = soundObj.Playing

		if not isfile(selectedLMSPath) then
			warn('File not found: ' .. selectedLMSPath)
			return
		end

		local asset
		if getcustomasset then
			asset = getcustomasset(selectedLMSPath)
		elseif getsynasset then
			asset = getsynasset(selectedLMSPath)
		end

		if asset and asset ~= '' then
			soundObj.SoundId = asset
			soundObj.TimePosition = timePosition
			if wasPlaying then
				soundObj:Play()
			end
		else
			warn('Failed to load custom asset for: ' .. selectedLMSPath)
		end
	end)

	if not success then
		warn('Error applying LMS custom sound: ' .. tostring(err))
	end
end

-- function to restore original LMS sound
local function restoreOriginalLMSSound(soundObj)
	if not soundObj or not soundObj:IsA('Sound') then
		return
	end

	pcall(function()
		local timePosition = soundObj.TimePosition
		local wasPlaying = soundObj.Playing

		soundObj.SoundId = 'rbxassetid://' .. LMS_TARGET_ID
		soundObj.Volume = 0.5
		soundObj.TimePosition = timePosition
		if wasPlaying then
			soundObj:Play()
		end
	end)
end

-- function to find and monitor LMS sound
local function findAndMonitorLMSSound()
	local position = workspace:FindFirstChild('Themes')
	if not position then
		return nil
	end

	for _, obj in ipairs(position:GetDescendants()) do
		if obj:IsA('Sound') and obj.Name == 'LastSurvivor' then
			local sid = tostring(obj.SoundId)
			if sid:find(LMS_TARGET_ID) then
				return obj
			elseif sid:find('rbxtempasset') or sid:find('rbxasset') then
				if currentLMSSound == obj then
					return obj
				end
				return nil
			end
			return nil
		end
	end
	return nil
end


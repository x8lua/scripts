-- Function to store original gunshot sound ID and volume
local function storeOriginalGunshotSound(sound)
	if
		sound:IsA('Sound')
		and not originalGunshotSounds[sound]
		and isTargetGunshotSound(sound.SoundId)
	then
		originalGunshotSounds[sound] = {
			soundId = sound.SoundId,
			volume = sound.Volume,
		}
		print(
			'🔍 Stored original gunshot sound for restoration: '
				.. sound.SoundId
		)
	end
end

-- Function to replace gunshot sound with custom version
local function tryReplaceGunshotSound(sound)
	if not sound:IsA('Sound') then
		return
	end
	if customGunshotId == '' then
		return
	end

	-- Replace if it matches target ID
	if isTargetGunshotSound(sound.SoundId) then
		-- Store original first (only for matching sounds)
		storeOriginalGunshotSound(sound)
		local wasPlaying = sound.Playing
		local parent = sound.Parent

		-- Format the custom ID properly
		local formattedId = customGunshotId
		if not formattedId:match('^rbxassetid://') then
			formattedId = 'rbxassetid://' .. formattedId
		end

		-- Always remove original sound and create new instance
		if parent then
			-- Remove the original sound
			sound:Destroy()

			-- Create new Sound instance
			local newSound = Instance.new('Sound')
			newSound.SoundId = formattedId
			newSound.Volume = customGunshotVolume
			newSound.Parent = parent

			-- Play the sound if the original was playing
			if wasPlaying then
				newSound:Play()
			end

			-- Remove the sound when it finishes playing
			local connection
			connection = newSound.Ended:Connect(function()
				if connection then
					connection:Disconnect()
				end
				if newSound and newSound.Parent then
					newSound:Destroy()
				end
			end)

			print(
				'🔫 Created new gunshot sound instance: '
					.. formattedId
					.. ' (will auto-remove when finished)'
			)
		end
	end
end

-- Function to restore original gunshot sound
local function restoreOriginalGunshotSound(sound)
	if not sound:IsA('Sound') then
		return
	end

	local originalData = originalGunshotSounds[sound]
	if originalData then
		local timePosition = sound.TimePosition
		local wasPlaying = sound.Playing

		sound.SoundId = originalData.soundId
		sound.TimePosition = timePosition
		sound.Volume = originalData.volume -- Restore original volume

		if wasPlaying then
			sound:Play()
		end

		print(
			'🔄 Restored original Chance gunshot sound: '
				.. originalData.soundId
		)
	end
end


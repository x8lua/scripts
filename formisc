    debugMode = false
}

local bfLastForceY = 0
local bfForceChangePattern = {}
local bfModificationCount = 0
local bfLastModificationTime = 0
local bfMonitoringConn = nil
local bfStatusLabel = nil
local bfDebugLabel = nil

local function getBFBodyForce(char)
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    return hrp:FindFirstChild("BodyForce")
end

local function modifyBFBodyForce(bodyForce, char)
    if not bfConfig.enabled or not bodyForce then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local lookVector = hrp.CFrame.LookVector
    local newForce = Vector3.new(
        lookVector.X * bfConfig.forwardSpeedModifier * 1000,
        bfConfig.targetMagnitude,
        lookVector.Z * bfConfig.forwardSpeedModifier * 1000
    )
    
    bodyForce.Force = newForce
    bfModificationCount = bfModificationCount + 1
    bfLastModificationTime = tick()
    
    if bfConfig.debugMode then
        print("[BodyForce] Modified! Count:", bfModificationCount, "Force:", newForce)
    end
end

local function updateBFStatusLabel()
    if not bfStatusLabel or not bfStatusLabel.SetText then return end
    local status = bfConfig.enabled and "Active" or "Disabled"
    pcall(function()
        bfStatusLabel:SetText("Status: " .. status .. " | Mods: " .. bfModificationCount)
    end)
end

local function updateBFDebugLabel(bodyForce, currentY)
    if not bfConfig.debugMode or not bfDebugLabel or not bfDebugLabel.SetText then return end
    local debugText = string.format("Y: %.1f | Last: %.1f", currentY, bfLastForceY)
    if bodyForce then
        local f = bodyForce.Force
        debugText = debugText .. string.format("\nForce: (%.0f, %.0f, %.0f)", f.X, f.Y, f.Z)
    else
        debugText = debugText .. "\nForce: Not Found"
    end
    pcall(function()
        bfDebugLabel:SetText(debugText)
    end)
end

local function startBFMonitoring()
    if bfMonitoringConn then bfMonitoringConn:Disconnect() end
    
    bfMonitoringConn = RunService.Heartbeat:Connect(function()
        if not bfConfig.enabled then return end
        
        local char = player.Character
        if not char then return end
        
        local bodyForce = getBFBodyForce(char)
        local currentY = 0
        
        if bodyForce then
            currentY = bodyForce.Force.Y
            
            if math.abs(bfLastForceY) < 100 and math.abs(currentY) > bfConfig.monitorThreshold then
                if bfConfig.debugMode then
                    print("[BodyForce] Spike detected! Y:", bfLastForceY, "->", currentY)
                end
                modifyBFBodyForce(bodyForce, char)
                bfForceChangePattern = {}
            end
            
            if math.abs(currentY - bfLastForceY) > 10 then
                table.insert(bfForceChangePattern, currentY)
                if #bfForceChangePattern > 5 then
                    table.remove(bfForceChangePattern, 1)
                end
                if bfConfig.debugMode then
                    print("[BodyForce] Y changed:", bfLastForceY, "->", currentY)
                end
            end
            
            bfLastForceY = currentY
        end
        
        updateBFDebugLabel(bodyForce, currentY)
    end)
    
    if bfConfig.debugMode then
        print("[BodyForce] Monitoring started")
    end
end

local function stopBFMonitoring()
    if bfMonitoringConn then
        bfMonitoringConn:Disconnect()
        bfMonitoringConn = nil
    end
    if bfConfig.debugMode then
        print("[BodyForce] Monitoring stopped")
    end
end



-- function to find and monitor Lobby sound
local function findAndMonitorLobbySound()
	local themesFolder = workspace:FindFirstChild('Themes')
	if not themesFolder then
		return nil
	end

	local lobbySound = themesFolder:FindFirstChild('lobby')
	if lobbySound and lobbySound:IsA('Sound') then
		local sid = tostring(lobbySound.SoundId)
		-- Store original ID if not already stored
		if
			not lobbySound:GetAttribute('OriginalSoundId')
			and not sid:find('rbxtempasset')
			and not sid:find('rbxasset')
		then

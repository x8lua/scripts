local autoTrickEnabled = false
local autoTrickMonitored = {}
local autoTrickConnections = {}

local function getBehaviorFolder()
	return ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Survivors"):WaitForChild("Veeronica"):WaitForChild("Behavior")
end

local function adorneeIsPlayerCharacter(h)
	if not h then return false end
	local adornee = h.Adornee
	local char = player.Character
	if not adornee or not char then return false end
	if adornee == char then return true end
	if adornee:IsDescendantOf(char) then return true end
	return false
end

local function safeConnectPropertyChanged(instance, prop, fn)
	local ok, signal = pcall(function() return instance:GetPropertyChangedSignal(prop) end)
	if ok and signal then
		return signal:Connect(fn)
	end
	return nil
end

-- Simulate Space key press using VirtualInputManager
local function pressSpace()
	local vim = game:GetService("VirtualInputManager")
	-- Press Space
	vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
	task.wait(0.09)
	-- Release Space
	vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end

local function monitorHighlight(h)
	if not h or autoTrickMonitored[h] then return end
	autoTrickMonitored[h] = true
	
	local prevState = adorneeIsPlayerCharacter(h)
	local connections = {}
	
	local function cleanup()
		for _, conn in ipairs(connections) do
			if conn and conn.Connected then
				conn:Disconnect()
			end
		end
		autoTrickMonitored[h] = nil
	end
	
	local function onChanged()
		if not h or not h.Parent then return end
		
		local currState = adorneeIsPlayerCharacter(h)
		if prevState ~= currState then
			if currState then
				print("[AutoTrick] Highlight's Adornee is PLAYER ->", h:GetFullName())
				-- Press Space when highlight targets the player
				task.spawn(pressSpace)
			else
				print("[AutoTrick] Highlight's Adornee is NOT player ->", h:GetFullName())
			end
		end
		prevState = currState
	end
	
	local c = safeConnectPropertyChanged(h, "Adornee", onChanged)
	if c then table.insert(connections, c) end
	
	table.insert(connections, h.AncestryChanged:Connect(function(_, parent)
		if not parent then
			print("[AutoTrick] Highlight destroyed!")
			cleanup()
		else
			onChanged()
		end
	end))
	
	table.insert(connections, player.CharacterAdded:Connect(onChanged))
	table.insert(connections, player.CharacterRemoving:Connect(onChanged))
	
	task.spawn(onChanged)
end

local function startAutoTrick()
	if autoTrickEnabled then return end
	autoTrickEnabled = true
	
	local ok, behaviorFolder = pcall(getBehaviorFolder)
	if not ok or not behaviorFolder then
		print("[AutoTrick] ERROR: Could not find Behavior folder")
		Library:Notify({ Title = "Auto Trick", Description = "Behavior folder not found", Time = 3 })
		autoTrickEnabled = false
		return
	end
	
	for _, desc in ipairs(behaviorFolder:GetDescendants()) do
		if desc:IsA("Highlight") then
			monitorHighlight(desc)
		end
	end
	
	table.insert(autoTrickConnections, behaviorFolder.DescendantAdded:Connect(function(child)
		if child:IsA("Highlight") then
			monitorHighlight(child)
			print("[AutoTrick] Highlight added ->", child:GetFullName())
		end
	end))
	
	print("[AutoTrick] Enabled - monitoring highlights")
	Library:Notify({ Title = "Auto Trick", Description = "Monitoring enabled", Time = 2 })
end

local function stopAutoTrick()
	autoTrickEnabled = false
	
	for _, conn in ipairs(autoTrickConnections) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	autoTrickConnections = {}
	
	for h, _ in pairs(autoTrickMonitored) do
		autoTrickMonitored[h] = nil
	end
	
	print("[AutoTrick] Disabled")
end

VeeronicaLeft:AddToggle("AutoTrickEnable", { Text = "Auto Trick", Default = false, Callback = function(v)
	if v then

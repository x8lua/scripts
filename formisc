local function monitorKillerSounds()
    if not soundMonitorEnabled then return end
    
    local killers = workspace:FindFirstChild("Players")
    if not killers then return end
    
    local killersFolder = killers:FindFirstChild("Killers")
    if not killersFolder then return end
    
    -- Clean up connections for players that no longer exist or lost their HRP
    local activeHRPs = {}
    for _, targetPlayer in ipairs(killersFolder:GetChildren()) do
        if targetPlayer:IsA("Model") then
            local hrp = targetPlayer:FindFirstChild("HumanoidRootPart")
            if hrp then
                activeHRPs[hrp] = true
            end
        end
    end
    
    -- Remove connections for HRPs that no longer exist
    for hrp, conn in pairs(soundMonitorHRPConnections) do
        if not activeHRPs[hrp] then
            if conn and conn.Connected then
                conn:Disconnect()
            end
            soundMonitorHRPConnections[hrp] = nil
        end
    end
    
    -- Monitor all players in Killers folder
    for _, targetPlayer in ipairs(killersFolder:GetChildren()) do
        if not targetPlayer:IsA("Model") then continue end
        
        local playerName = targetPlayer.Name
        local humanoidRootPart = targetPlayer:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then continue end
        
        -- Check all Sound objects in HumanoidRootPart
        for _, child in ipairs(humanoidRootPart:GetChildren()) do
            if child:IsA("Sound") then
                local soundIdString = tostring(child.SoundId)
                if soundIdString ~= "" and not detectedSounds[soundIdString] then
                    createSoundEntry(soundIdString, playerName)
                end
            end
        end
        
        -- Monitor for new sounds being added (only if not already connected)
        if not soundMonitorHRPConnections[humanoidRootPart] then
            local childAddedConn = humanoidRootPart.ChildAdded:Connect(function(child)
                if child:IsA("Sound") then
                    local soundIdString = tostring(child.SoundId)
                    if soundIdString ~= "" and not detectedSounds[soundIdString] then
                        createSoundEntry(soundIdString, playerName)
                    end
                end
            end)
            soundMonitorHRPConnections[humanoidRootPart] = childAddedConn
            table.insert(soundMonitorConnections, childAddedConn)
        end
    end
end


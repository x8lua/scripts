	vignette.Position = UDim2.new(0, 0, 0, 0)
	vignette.BackgroundTransparency = 1
	vignette.Image = 'rbxassetid://3156051342'
	vignette.ImageTransparency = 1
	vignette.ScaleType = Enum.ScaleType.Fit
	vignette.ZIndex = 2
	vignette.Parent = screenGui

	local running = true
	local flickState = false
	local lastFlick = 0
	local isZeroTriggered = false

	local function fadeVignette(targetAlpha, speed)
		TweenService
					:Create(
						vignette,
						TweenInfo.new(speed, Enum.EasingStyle.Linear),
						{
				ImageTransparency = targetAlpha,
						}
					)
			:Play()
	end

	local function setTextTransparency(value, speed)
		TweenService
					:Create(
						textLabel,
						TweenInfo.new(speed, Enum.EasingStyle.Linear),
						{
				TextTransparency = value,
						}
					)
			:Play()
	end

	local renderConnection = RunService.RenderStepped:Connect(function()
		if not running or not staminaWarningActive then
			running = false
			return
		end

		local text = staminaValue.Text or '0/100'
		textLabel.Text = text

		local current, total = string.match(text, '(%d+)%s*/%s*(%d+)')
		current = tonumber(current) or 0
		total = tonumber(total) or 100
		local ratio = math.clamp(current / total, 0, 1)

		if current == 0 and not isZeroTriggered then
			isZeroTriggered = true
			textLabel.Text = 'fuck you'

			TweenService:Create(
				textLabel,
				TweenInfo.new(
					1,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.Out
				),
				{
					TextTransparency = 1,
				}
			):Play()

			task.delay(1.1, function()
				isZeroTriggered = false
			end)
			return
		end

		if ratio <= 0.3 then
			local strength = 1 - (ratio / 0.3)
			local textTransparency = 1 - (0.9 * strength)
			local vignetteAlpha = 1 - (strength * 0.9)
			setTextTransparency(textTransparency, 0.1)
			fadeVignette(vignetteAlpha, 0.1)
		else
			setTextTransparency(1, 0.2)
			fadeVignette(1, 0.3)
		end

		if ratio <= 0.3 then
					local flickInterval =
						math.clamp((ratio ^ 2.2) * 0.25, 0.03, 0.25)
			if tick() - lastFlick >= flickInterval then
				lastFlick = tick()
				flickState = not flickState
						local targetColor = flickState
								and Color3.fromRGB(255, 80, 80)
					or Color3.fromRGB(255, 255, 255)
						TweenService
							:Create(
					textLabel,
								TweenInfo.new(
									flickInterval / 2,
									Enum.EasingStyle.Quad
								),
					{
						TextColor3 = targetColor,
					}
							)
							:Play()
			end
		else
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		end

		if ratio <= 0.3 then
					local strength = (ratio > 0.16)
							and ((0.3 - ratio) / (0.3 - 0.16))
				or 1
			local intensity = 0.5 * strength + 0.15
			local offsetX = (math.random() - 0.5) * intensity
			local offsetY = (math.random() - 0.5) * intensity
			camera.CFrame = camera.CFrame * CFrame.new(offsetX, offsetY, 0)
			textLabel.Position = UDim2.new(
				0.5,
				math.random(-10 * strength, 10 * strength),
				0.58,
				math.random(-10 * strength, 10 * strength)
			)
		else
			textLabel.Position = UDim2.new(0.5, 0, 0.58, 0)
		end
	end)

	staminaWarningCleanup = function()
		running = false
		if renderConnection then
			renderConnection:Disconnect()
		end
		if screenGui then
			screenGui:Destroy()
		end
	end

	Library:Notify({
		Title = '✅ Stamina Warning Enabled',
		Content = 'Visual overlay will appear when stamina is low',
		Duration = 3,
	})
end


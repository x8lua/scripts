	-- Forward declarations
	local updateRemoveDropdownOptions

	local function updateGunshotDropdownOptions()
		gunshotDropdownOptions = { 'Select Saved Sound' }

		for _, sound in ipairs(savedGunshotSounds) do
			table.insert(
				gunshotDropdownOptions,
				sound.name .. ' (' .. sound.soundId .. ')'
			)
		end

		-- Refresh dropdown if it exists
		if currentGunshotDropdown and currentGunshotDropdown.SetValues then
			pcall(function()
				currentGunshotDropdown:SetValues(gunshotDropdownOptions)
			end)
		end

		-- Also update remove dropdown
		if updateRemoveDropdownOptions then
			updateRemoveDropdownOptions()
		end
	end

	local function loadGunshotSounds()
		local success, result = pcall(function()
			if isfile(gunshotSaveFile) then
				local data = readfile(gunshotSaveFile)
				return HttpService:JSONDecode(data)
			end
			return {}
		end)

		if success and type(result) == 'table' then
			savedGunshotSounds = result
			print('🔫 Loaded', #savedGunshotSounds, 'saved gunshot sounds')
		else
			savedGunshotSounds = {}
			print('🔫 No saved gunshot sounds found, starting fresh')
		end

		updateGunshotDropdownOptions()
	end

	local function saveGunshotSounds()
		local success, error = pcall(function()
			local data = HttpService:JSONEncode(savedGunshotSounds)
			writefile(gunshotSaveFile, data)
		end)

		if success then
			print('🔫 Gunshot sounds saved successfully')
			return true
		else
			print('❌ Failed to save gunshot sounds:', error)
			return false
		end
	end

	local function addGunshotSound(name, soundId)
		if name == '' or soundId == '' then
			return false, 'Name and Sound ID cannot be empty'
		end

		-- Check if name already exists
		for i, sound in ipairs(savedGunshotSounds) do
			if sound.name == name then
				return false, 'Sound name already exists'
			end
		end

		table.insert(savedGunshotSounds, {
			name = name,
			soundId = soundId,
			timestamp = os.time(),
		})

		saveGunshotSounds()
		updateGunshotDropdownOptions()
		return true, 'Sound saved successfully'
	end

	local function removeGunshotSound(name)
		if not name or name == '' or name == 'Select Saved Sound' then
			return false, 'Please select a valid sound to remove'
		end

		-- Extract sound name from dropdown format "Name (ID)"
		local soundName = name:match('^(.+) %(.+%)$') or name

		-- Find and remove the sound
		for i, sound in ipairs(savedGunshotSounds) do
			if sound.name == soundName then
				table.remove(savedGunshotSounds, i)
				saveGunshotSounds()
				updateGunshotDropdownOptions()
				if updateRemoveDropdownOptions then
					updateRemoveDropdownOptions()
				end
				return true, "Sound '" .. soundName .. "' removed successfully"
			end
		end

		return false, 'Sound not found in saved list'
	end

	function updateRemoveDropdownOptions()
		local removeOptions = { 'Select Sound to Remove' }

		for _, sound in ipairs(savedGunshotSounds) do
			table.insert(
				removeOptions,
				sound.name .. ' (' .. sound.soundId .. ')'
			)
		end


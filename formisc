		local function rollToReroll(target)
			print('🎰 rollToReroll called with target: ' .. tostring(target))
		target =
			math.clamp(math.floor(target + 0.5), REROLL_MIN_VAL, REROLL_MAX_VAL)
		print('🎰 Clamped target: ' .. target .. ', current health: ' .. rerollMaxHealth .. ', effect active: ' .. tostring(rerollEffectActive))
		if target == rerollMaxHealth or not rerollEffectActive then
			print('🎰 Skipping rollToReroll - target matches current or effect inactive')
			return
		end

			local myID = rerollActiveID + 1
			rerollActiveID = myID

			local healthBar = player.PlayerGui:FindFirstChild('TemporaryUI')
			if healthBar then
				local bars = healthBar:FindFirstChild('PlayerInfo')
				if bars then
					bars = bars:FindFirstChild('Bars')
					if bars then
						local health = bars:FindFirstChild('Health')
						if health then
							health.Visible = false
						end
					end
				end
			end

		local diff = target - rerollMaxHealth
		local steps = math.abs(diff)
		local isHealthLoss = diff < 0

			task.spawn(function()
				if not rerollEffectActive then
					return
				end
				local fadeVal = Instance.new('NumberValue')
				fadeVal.Value = 1
				fadeVal.Parent = rerollGui or player.PlayerGui
				local conn
				conn = RunService.RenderStepped:Connect(function()
					if not rerollEffectActive then
						conn:Disconnect()
						return
					end
					for _, lbl in ipairs(rerollLabels) do
						if lbl and lbl.Parent then
							lbl.TextTransparency = 0.5 + 0.5 * fadeVal.Value
							lbl.TextStrokeTransparency = 0.4 + 0.6 * fadeVal.Value
						end
					end
				end)
				local t = TweenService:Create(
					fadeVal,
					TweenInfo.new(
						0.8,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),
					{ Value = 0 }
				)
				t:Play()
				t.Completed:Wait()
				conn:Disconnect()
				fadeVal:Destroy()
			end)

			local garbageSound = playRerollGarbageSFX(steps)

			if isHealthLoss and garbageSound then
				task.spawn(function()
					garbageSound.Ended:Wait()
					if rerollEffectActive then
						playRerollDamageSFX(steps)
					end
				end)
			end

			task.wait(1)

			if myID ~= rerollActiveID or not rerollEffectActive then
				return
			end
			local duration = 3
			local tw = tweenRerollTrackTo(target, duration)
			if tw then
				-- Stop the spam hiding when tween starts
				if rerollConnections.spamHideMessage then
					rerollConnections.spamHideMessage:Disconnect()
					rerollConnections.spamHideMessage = nil
					print('🛑 Stopped spam hiding - tween animation started')
				end
				
				tw:Play()
			tw.Completed:Wait()
		end
		if myID ~= rerollActiveID or not rerollEffectActive then
			return
		end
		rerollMaxHealth = target

		if not isHealthLoss then
			playRerollHealthGainSFX(steps)
		end

			task.spawn(function()
				if not rerollEffectActive then
					return
				end

				local healthBar = player.PlayerGui:FindFirstChild('TemporaryUI')
				if healthBar then
					local bars = healthBar:FindFirstChild('PlayerInfo')
					if bars then
						bars = bars:FindFirstChild('Bars')
						if bars then
							local health = bars:FindFirstChild('Health')
							if health then
								local originalPosition = health.Position

								health.Position = UDim2.new(
									originalPosition.X.Scale,
									originalPosition.X.Offset,
									originalPosition.Y.Scale + 2,
									originalPosition.Y.Offset
								)
								health.Visible = true

								task.wait()

								local healthSlideTween = TweenService:Create(
									health,
									TweenInfo.new(
										0.8,
										Enum.EasingStyle.Quad,
										Enum.EasingDirection.Out
									),
									{ Position = originalPosition }
								)
								healthSlideTween:Play()
							end
						end
					end
				end

				local fadeVal = Instance.new('NumberValue')
				fadeVal.Value = 0
				fadeVal.Parent = rerollGui or player.PlayerGui
				local conn
				conn = RunService.RenderStepped:Connect(function()
					if not rerollEffectActive then
						conn:Disconnect()
						return
					end
					for _, lbl in ipairs(rerollLabels) do
						if lbl and lbl.Parent then
							lbl.TextTransparency = 0.5 + 0.5 * fadeVal.Value
							lbl.TextStrokeTransparency = 0.4 + 0.6 * fadeVal.Value
						end
					end
				end)
				local t = TweenService:Create(
					fadeVal,
					TweenInfo.new(
						0.8,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.In
					),
					{ Value = 1 }
				)
				t:Play()
				t.Completed:Wait()
				conn:Disconnect()
				fadeVal:Destroy()

				if rerollEffectActive then
					showRerollTierDisplay(target)
				end
			end)
		end


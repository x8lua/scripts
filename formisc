		-- Helper functions
		local function yForReroll(v)
			if not rerollContainer then
				return 0
			end
			local centerOffset = rerollContainer.AbsoluteSize.Y / 2
			local cellH =
				math.max(1, math.floor(rerollContainer.AbsoluteSize.Y * 1.2))
			local valuePosition = (REROLL_MAX_VAL - v) * cellH
			return -(valuePosition - centerOffset + cellH / 2)
		end

		local function tweenRerollTrackTo(v, dur)
			if not rerollTrack then
				return nil
			end
			return TweenService:Create(
				rerollTrack,
				TweenInfo.new(
					dur,
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.fromOffset(0, yForReroll(v)),
				}
			)
		end

		local function cancelRerollActive()
			rerollActiveID = rerollActiveID + 1
		end

		local function showRerollTierDisplay(health)
			if not rerollTierFrame or not rerollTierTitle or not rerollTierDesc then
				return
			end

			task.spawn(function()
				local tierInfo = getRerollTierInfo(health)

				rerollTierTitle.Text = tierInfo.name
				rerollTierTitle.Font = tierInfo.font
				rerollTierTitle.TextColor3 = tierInfo.color
				rerollTierDesc.Text = tierInfo.desc

				local uiStroke = rerollTierTitle:FindFirstChild('UIStroke')
				if tierInfo.isJackpot then
					if not uiStroke then
						uiStroke = Instance.new('UIStroke')
						uiStroke.Parent = rerollTierTitle
					end
					uiStroke.Color = Color3.fromRGB(255, 215, 0)
					uiStroke.Thickness = 4
					uiStroke.Transparency = 0

					task.spawn(function()
						local pulseValue = Instance.new('NumberValue')
						pulseValue.Value = 0
						local startTime = tick()
						local conn
						conn = RunService.RenderStepped:Connect(function()
							local elapsed = tick() - startTime
							if elapsed > 5 or not rerollEffectActive then
								conn:Disconnect()
								pulseValue:Destroy()
								return
							end
							local pulse = 0.5 + 0.5 * math.sin(elapsed * 4)
							if uiStroke and uiStroke.Parent then
								uiStroke.Thickness = 4 + 2 * pulse
								uiStroke.Transparency = 0.2 * (1 - pulse)
							end
						end)
					end)
				elseif uiStroke then
					uiStroke:Destroy()
				end

				rerollTierFrame.Visible = true

				local fadeInVal = Instance.new('NumberValue')
				fadeInVal.Value = 1
				fadeInVal.Parent = rerollTierFrame
				local conn1
				conn1 = RunService.RenderStepped:Connect(function()
					if
						not rerollEffectActive
						or not rerollTierTitle
						or not rerollTierDesc
					then
						conn1:Disconnect()
						return
					end
					rerollTierTitle.TextTransparency = fadeInVal.Value
					rerollTierTitle.TextStrokeTransparency = 0.5
						+ 0.5 * fadeInVal.Value
					rerollTierDesc.TextTransparency = fadeInVal.Value
					rerollTierDesc.TextStrokeTransparency = 0.7
						+ 0.3 * fadeInVal.Value
				end)
				local fadeInTween = TweenService:Create(
					fadeInVal,
					TweenInfo.new(
						0.5,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),
					{ Value = 0 }
				)
				fadeInTween:Play()
				fadeInTween.Completed:Wait()
				conn1:Disconnect()
				fadeInVal:Destroy()

				task.wait(5)

				if not rerollEffectActive then
					return
				end

				local fadeOutVal = Instance.new('NumberValue')
				fadeOutVal.Value = 0
				fadeOutVal.Parent = rerollTierFrame
				local conn2
				conn2 = RunService.RenderStepped:Connect(function()
					if
						not rerollEffectActive
						or not rerollTierTitle
						or not rerollTierDesc
					then
						conn2:Disconnect()
						return
					end
					rerollTierTitle.TextTransparency = fadeOutVal.Value
					rerollTierTitle.TextStrokeTransparency = 0.5
						+ 0.5 * fadeOutVal.Value
					rerollTierDesc.TextTransparency = fadeOutVal.Value
					rerollTierDesc.TextStrokeTransparency = 0.7
						+ 0.3 * fadeOutVal.Value
				end)
				local fadeOutTween = TweenService:Create(
					fadeOutVal,
					TweenInfo.new(
						0.5,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.In

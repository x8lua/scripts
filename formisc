local colorCorrectionEnabled = false
local colorCorrectionLoop = nil

local function checkAndEditColorCorrection()
	if not colorCorrectionEnabled then return end
	
	local lighting = game:GetService("Lighting")
	local colorCorrections = lighting:GetChildren()
	local ccList = {}
	
	-- Find all ColorCorrectionEffects
	for _, child in ipairs(colorCorrections) do
		if child:IsA("ColorCorrectionEffect") then
			table.insert(ccList, child)
		end
	end
	
	if #ccList == 0 then return end
	
	-- Check and edit each ColorCorrection
	for _, colorCorrection in ipairs(ccList) do
		-- Check if states match the target values
		-- Target: Brightness = 0.06, Contrast = 0.2, Enabled = true, Saturation = -0.55
		local brightness = colorCorrection.Brightness
		local contrast = colorCorrection.Contrast
		local saturation = colorCorrection.Saturation
		local enabled = colorCorrection.Enabled
		
		-- Check if values are close to the target (using small tolerance for floating point)
		local brightnessMatch = math.abs(brightness - 0.06) < 0.01
		local contrastMatch = math.abs(contrast - 0.2) < 0.01
		local saturationMatch = math.abs(saturation - (-0.55)) < 0.01
		local enabledMatch = enabled == true
		
		if brightnessMatch and contrastMatch and saturationMatch and enabledMatch then
			-- Apply the new values
			colorCorrection.Brightness = 0.3
			colorCorrection.Contrast = 0.3
			colorCorrection.Saturation = 0
			
			-- Show notification
			Library:Notify({ Title = "Color Correction", Description = string.format("Edited '%s'!", colorCorrection.Name), Time = 2 })
		end
	end
end

local function startColorCorrectionMonitor()
	if colorCorrectionEnabled then return end
	colorCorrectionEnabled = true
	
	-- Check every single second
	colorCorrectionLoop = task.spawn(function()
		while colorCorrectionEnabled do
			checkAndEditColorCorrection()
			task.wait(1)
		end
	end)
	
	Library:Notify({ Title = "Color Correction", Description = "Monitoring enabled", Time = 2 })
end

local function stopColorCorrectionMonitor()
	colorCorrectionEnabled = false
	
	if colorCorrectionLoop then
		task.cancel(colorCorrectionLoop)
		colorCorrectionLoop = nil
	end
	
	Library:Notify({ Title = "Color Correction", Description = "Monitoring disabled", Time = 2 })
end


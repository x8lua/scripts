-- 嘗試放置到 CoreGui，失敗則放進 PlayerGui
local success, err = pcall(function()
    Notification.Gui.Parent = game:GetService("CoreGui")
end)
if not success then
    Notification.Gui.Parent = Plr:WaitForChild("PlayerGui")
end

-- Scripts
if Plr.Team ~= nil then
    Notification.setColor(Plr.TeamColor.Color)
end

Plr:GetPropertyChangedSignal("Team"):Connect(function()
    if Plr.Team ~= nil then
        Notification.setColor(Plr.TeamColor.Color)
    end
end)

return Notification

-- Rank-Based Join/Leave Messages Script
-- This script displays different messages based on the player's social credit rank
-- Separate from StacyCMD main script

local function chat(msg)
    game.Players:Chat(msg)
end

-- Social Credit Data Storage (connected to main system)
local SOCIAL_CREDIT_FILE = 'stacycmd_social_credit.json'
_G.__stacySocialCredit = _G.__stacySocialCredit or {}
local socialCreditData = _G.__stacySocialCredit

-- Load social credit data from JSON file
local function loadSocialCredit()
    local ok, content = pcall(readfile, SOCIAL_CREDIT_FILE)
    if ok and content then
        local success, data = pcall(function()
            return game:GetService('HttpService'):JSONDecode(content)
        end)
        if success and type(data) == 'table' then
            for k, v in pairs(data) do
                socialCreditData[k] = v
            end
        end
    end
end

-- Load data on script start
loadSocialCredit()

-- Periodically reload social credit data to stay synced
spawn(function()
    while true do
        wait(30) -- Reload every 30 seconds
        loadSocialCredit()
    end
end)

-- Function to get player's social credit
function getPlayerSocialCredit(playerName)
    local key = playerName:lower()
    return socialCreditData[key] or 0
end

-- Function to get player's rank (mirrored from main system)
local function getSocialCreditRank(score, playerName)
    -- Special case for DerpyB33 - always show "Durp" rank regardless of SC
    if playerName and playerName:lower() == 'derpyb33' then
        return 'Durp'
    end

    -- Negative ranks (Prohibit tiers) - every 250 SC with unlimited Roman numerals
    if score < 0 then
        local prohibitLevel = math.floor(math.abs(score) / 250) + 1

        -- Convert any number to Roman numerals
        local function toRoman(num)
            local romanNumerals = {
                { 1000, 'M' },
                { 900, 'CM' },
                { 500, 'D' },
                { 400, 'CD' },
                { 100, 'C' },
                { 90, 'XC' },
                { 50, 'L' },
                { 40, 'XL' },
                { 10, 'X' },
                { 9, 'IX' },
                { 5, 'V' },
                { 4, 'IV' },
                { 1, 'I' },
            }
            local result = ''
            for _, pair in ipairs(romanNumerals) do
                local value, numeral = pair[1], pair[2]
                while num >= value do
                    result = result .. numeral
                    num = num - value
                end
            end
            return result
        end

        return '🚫 ' .. toRoman(prohibitLevel)

    -- Basic/Low Tiers
    elseif score >= 0 and score <= 500 then
        return 'Novice'

    -- Bronze Tier
    elseif score >= 500 and score <= 1200 then
        return 'Bronze I'
    elseif score >= 1200 and score <= 1900 then
        return 'Bronze II'
    elseif score >= 1900 and score <= 2600 then
        return 'Bronze III'

    -- Silver Tier
    elseif score >= 2600 and score <= 3300 then
        return 'Silver I'
    elseif score >= 3300 and score <= 4000 then
        return 'Silver II'
    elseif score >= 4000 and score <= 5000 then
        return 'Silver III'

    -- Gold Tier
    elseif score >= 5000 and score <= 5800 then
        return 'Gold I'
    elseif score >= 5800 and score <= 6600 then
        return 'Gold II'
    elseif score >= 6600 and score <= 8000 then
        return 'Gold III'

    -- Platinum Tier (Prestige)
    elseif score >= 8000 and score <= 8800 then
        return 'PlatinumI'
    elseif score >= 8800 and score <= 9600 then
        return 'PlatinumII'
    elseif score >= 9600 and score <= 11000 then
        return 'PlatinumIII'

    -- Diamond Tier (Prestige)
    elseif score >= 11000 and score <= 11900 then
        return 'DiamondI'
    elseif score >= 11900 and score <= 12800 then
        return 'DiamondII'
    elseif score >= 12800 and score <= 14000 then
        return 'DiamondIII'

    -- Grandmaster Tier (Prestige)
    elseif score >= 14000 and score <= 15000 then
        return 'GrandmasterI'
    elseif score >= 15000 and score <= 16000 then
        return 'GrandmasterII'
    elseif score >= 16000 and score <= 17000 then

-- Main join function
local function onPlayerAdded(player)
    -- Get player's social credit and rank
    local playerSC = getPlayerSocialCredit(player.Name)
    local playerRank = getSocialCreditRank(playerSC, player.Name)
    local rankTier = getRankTier(playerRank)

    -- Get appropriate messages for this rank tier
    local messages = RANK_JOIN_MESSAGES[rankTier]
        or RANK_JOIN_MESSAGES['novice']

    -- Generate a random join message
    local message = messages[math.random(1, #messages)]

    -- Replace the [player] placeholder with the player's display name
    message = message:gsub('%[player%]', player.DisplayName)

    -- Add rank information to the message
    local rankInfo = ' [' .. playerRank .. ' - ' .. playerSC .. ' SC]'
    message = message .. rankInfo

    -- Get display configuration for this rank tier
    local config = getRankDisplayConfig(rankTier, playerRank)

    -- Display the message in the chat with appropriate styling
    -- Execute music and chat commands separately to avoid pipe issues
    chat(':music ' .. config.music .. ' true 1 1 ' .. config.volume)
    chat(
        ':chatnotifyc all '
            .. config.color
            .. " <font face= 'GothamBold'>"
            .. message
            .. '</font>'
    )
end

-- Main leave function
local function onPlayerRemoving(player)
    -- Get player's social credit and rank
    local playerSC = getPlayerSocialCredit(player.Name)
    local playerRank = getSocialCreditRank(playerSC, player.Name)
    local rankTier = getRankTier(playerRank)

    -- Get appropriate messages for this rank tier
    local messages = RANK_LEAVE_MESSAGES[rankTier]
        or RANK_LEAVE_MESSAGES['novice']

    -- Generate a random leave message
    local message = messages[math.random(1, #messages)]

    -- Replace the [player] placeholder with the player's display name
    message = message:gsub('%[player%]', player.DisplayName)

    -- Add rank information to the message
    local rankInfo = ' [' .. playerRank .. ' - ' .. playerSC .. ' SC]'
    message = message .. rankInfo

    -- Get display configuration for this rank tier
    local config = getRankDisplayConfig(rankTier, playerRank)

    -- Display the message in the chat with appropriate styling (slightly different music for leaves)
    -- Execute music and chat commands separately to avoid pipe issues
    chat(':music 3352057095 true 1 3 ' .. (config.volume * 0.7))
    chat(
        ':chatnotifyc all '
            .. config.color
            .. " <font face= 'GothamBold'>"
            .. message
            .. '</font>'
    )
end


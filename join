-- Function to get appropriate music for a specific rank
local function getRankMusic(rank)
    -- First check for specific rank sounds (these are the primary custom sounds)
    if SPECIFIC_RANK_SOUNDS[rank] then
        return SPECIFIC_RANK_SOUNDS[rank]
    end

    -- For mid-tier ranks (Platinum, Diamond, Grandmaster, Epic), use specific music
    if
        rank:find('Platinum')
        or rank:find('Diamond')
        or rank:find('Grandmaster')
        or rank:find('Epic')
    then
        return MID_TIER_MUSIC
    end

    -- For high-tier ranks without specific sounds, use custom sound for Spawn and above
    if
        rank:find('Legacy')
        or rank:find('Ascend')
        or rank:find('Celest')
        or rank:find('Divine')
        or rank:find('Eternal')
        or rank:find('Supreme')
        or rank:find('Imperial')
        or rank:find('Ω')
    then
        return SPAWN_AND_ABOVE_SOUND
    end

    -- Default to standard tier music
    return TIER_MUSIC_ID
end


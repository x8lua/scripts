end

-- Function to get rank tier for message categorization
local function getRankTier(rank)
    -- Special cases
    if rank == 'Durp' then
        return 'special'
    end

    -- Prohibit tiers (negative)
    if rank:find('🚫') then
        return 'prohibit'
    end

    -- Basic tier
    if rank == 'Novice' then
        return 'novice'
    end

    -- Bronze tier
    if rank:find('Bronze') then
        return 'bronze'
    end

    -- Silver tier
    if rank:find('Silver') then
        return 'silver'
    end

    -- Gold tier
    if rank:find('Gold') then
        return 'gold'
    end

    -- Prestige tiers
    if
        rank:find('Platinum')
        or rank:find('Diamond')
        or rank:find('Grandmaster')
        or rank:find('Zenith')
    then
        return 'prestige'
    end

    -- Elite tiers
    if rank:find('Epic') or rank:find('Mythic') then
        return 'elite'
    end

    -- Legendary tiers
    if
        rank == 'Spawn'
        or rank:find('Legacy')
        or rank:find('Ascend')
        or rank:find('Celest')
    then
        return 'legendary'
    end

    -- Divine tiers
    if rank:find('Divine') or rank:find('Eternal') or rank:find('Supreme') then
        return 'divine'
    end

    -- Ultimate tiers
    if rank:find('Imperial') or rank:find('Ω') then
        return 'ultimate'
    end

    return 'unknown'
end


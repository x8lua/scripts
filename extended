-- Function to find player by username (supports shortened names)
local function findPlayerByName(searchName)
    if not searchName or searchName == '' then
        return nil
    end

    searchName = searchName:lower()

    -- First try exact match
    for _, player in pairs(game.Players:GetPlayers()) do
        if player.Name:lower() == searchName then
            return player
        end
    end

    -- Then try partial match (starts with)
    for _, player in pairs(game.Players:GetPlayers()) do
        if player.Name:lower():sub(1, #searchName) == searchName then
            return player
        end
    end

    -- Finally try contains match
    for _, player in pairs(game.Players:GetPlayers()) do
        if player.Name:lower():find(searchName, 1, true) then
            return player
        end
    end

    return nil
end

-- Function to select nearest target
local function selectNearestTarget()
    local nearestPlayer, distance = getNearestPlayer(
        lp.Character
                and lp.Character.HumanoidRootPart
                and lp.Character.HumanoidRootPart.Position
            or Vector3.new(0, 0, 0)
    )

    if nearestPlayer and distance < 80 then
        target = nearestPlayer
        targetLabel:SetDesc('Target: ' .. nearestPlayer.Name)

        ui:Notify({
            Title = 'Target Selected',
            Content = 'Target: ' .. nearestPlayer.Name,
            Icon = 'target',
            Duration = 3,
        })
    else
        ui:Notify({
            Title = 'No Target',
            Content = 'No player found nearby',
            Icon = 'alert-circle',
            Duration = 2,
        })
    end
end

-- Function to set target by username
local function setTargetByName(username)
    local player = findPlayerByName(username)

    if player and player ~= lp then
        target = player
        targetLabel:SetDesc('Target: ' .. player.Name)

        ui:Notify({
            Title = 'Target Set',
            Content = 'Target: ' .. player.Name,
            Icon = 'target',
            Duration = 3,
        })
        return true
    else
        ui:Notify({
            Title = 'Player Not Found',
            Content = username == '' and 'Please enter a username'
                or ('No player found matching: ' .. username),
            Icon = 'alert-circle',
            Duration = 3,
        })
        return false
    end
end


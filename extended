local function mainLoop()
    local inArena = true
    if
        workspace:FindFirstChild(lp.Name)
        and workspace[lp.Name]:FindFirstChild('IsInArena')
    then
        inArena = workspace[lp.Name].IsInArena.Value
    end

    if not inArena then
        statusLabel:SetDesc(
            '[PAUSED - NOT IN ARENA] System paused until you enter arena'
        )
        return
    end

    if not target or not target.Character then
        if target then
            target = nil
            targetLabel:SetDesc('Target left game')
        end
        return
    end

    local dist = getDistance()
    local time = tick()

    local status = active and 'ACTIVE' or 'STOPPED'
    local inRange = dist >= settings.minDist and dist <= settings.maxDist
    local gloveStatus = settings.autoMode
            and (hasGlove and ' | Glove: EQUIPPED' or ' | Glove: UNEQUIPPED')
        or ''
    statusLabel:SetDesc(
        string.format(
            '[%s] Target: %s | Distance: %.1f studs | In Range: %s%s',
            status,
            target.Name,
            dist,
            inRange and 'YES' or 'NO',
            gloveStatus
        )
    )

    if active and inRange and time - lastHit >= settings.attackDelay then
        if settings.autoMode and not hasGlove then
            equipGlove()
        end

        if settings.shouldLook and not looking then
            looking = true
            lookStart = time
            lookAt()
        elseif settings.shouldLook and looking then
            if time - lookStart >= settings.lookTime then
                attack()
                lastHit = time
                looking = false

                if settings.autoMode and hasGlove then
                    spawn(function()
                        local offset = (math.random() - 0.5)
                            * 2
                            * settings.randomRange
                        local delay =
                            math.max(0.1, settings.unequipTime + offset)
                        wait(delay)
                        unequipGlove()
                    end)
                end

                ui:Notify({
                    Title = 'Attack!',
                    Content = 'Attacked '
                        .. target.Name
                        .. (settings.autoMode and ' (Auto)' or ''),
                    Icon = 'sword',
                    Duration = 1,
                })
            end
        elseif not settings.shouldLook then
            attack()
            lastHit = time

            if settings.autoMode and hasGlove then
                spawn(function()
                    local offset = (math.random() - 0.5)
                        * 2
                        * settings.randomRange
                    local delay = math.max(0.1, settings.unequipTime + offset)
                    wait(delay)
                    unequipGlove()
                end)
            end
        end
    elseif not inRange then
        looking = false
        if settings.autoMode and hasGlove and time - lastUnequip > 1.0 then
            unequipGlove()
        end
    else
        looking = false
    end
end

